{
  "name": "ends-and-means",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm validate && astro build",
    "preview": "astro preview",
    "lint": "biome lint --error-on-warnings . && pnpm lint:markdown",
    "lint:fix": "biome lint --write . && pnpm lint:markdown --fix",
    "lint:markdown": "markdownlint-cli2 && pnpm lint:narrative",
    "lint:narrative": "node --import tsx scripts/lint-narratives.ts",
    "static": "knip --include files,dependencies,unlisted,binaries,unresolved,cycles",
    "check": "astro check",
    "test": "vitest run tests/content tests/delivery tests/skills",
    "test:coverage": "vitest run tests/content tests/delivery tests/skills --coverage",
    "test:routes": "vitest run tests/routes",
    "test:visual": "playwright test",
    "review:visual": "playwright test",
    "validate": "node --import tsx scripts/validate-domain.ts",
    "audit:content": "node --import tsx scripts/audit-content.ts",
    "audit:corpus-diversity": "node --import tsx scripts/audit-corpus-diversity.ts",
    "audit:provenance": "node --import tsx scripts/audit-provenance.ts",
    "inventory:dependencies": "node --import tsx scripts/generate-lockfile-provenance.ts",
    "audit:delivery": "node --import tsx scripts/audit-repository-delivery.ts && node --import tsx scripts/audit-skill-contracts.ts && node --import tsx scripts/audit-delivery.ts",
    "audit:content-integrity": "node --import tsx scripts/verify-content-integrity.ts",
    "verify": "pnpm audit:delivery -- --repository-only && pnpm audit:provenance && pnpm audit:corpus-diversity && pnpm lint && pnpm static && pnpm audit --audit-level=moderate && pnpm check && pnpm test:coverage && pnpm build && pnpm audit:content-integrity && pnpm test:routes && pnpm test:visual"
  },
  "dependencies": {
    "astro": "^7.3.1",
    "micromark": "^4.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler": "^4.0.0",
    "@biomejs/biome": "^2.5.12",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "knip": "^6.34.0",
    "markdownlint-cli2": "^0.23.2",
    "markdownlint-sentences-per-line": "^0.1.4",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "knip": {
    "ignoreDependencies": [
      "@emnapi/core",
      "@emnapi/runtime"
    ]
  }
}
