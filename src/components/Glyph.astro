---
import {
  type GlyphName,
  glyphs,
} from "../lib/presentation-glyphs";

type Size = "small" | "medium" | "large";
type Tone = "default" | "accent" | "evidence" | "warning";
type Props =
  | {
      glyph?: GlyphName;
      decorative?: true;
      label?: never;
      size?: Size;
      tone?: Tone;
    }
  | {
      glyph?: GlyphName;
      decorative: false;
      label: string;
      size?: Size;
      tone?: Tone;
    };

const {
  glyph,
  decorative = true,
  label,
  size = "medium",
  tone = "default",
} = Astro.props;
const definition = glyph ? glyphs[glyph] : undefined;
const Icon = definition?.component;
const accessibleLabel = decorative ? undefined : label;
---

{Icon ? (
  <span
    class:list={["glyph", `glyph--${size}`, `glyph--${tone}`]}
    data-glyph={glyph}
    data-glyph-purpose={definition.purpose}
  >
    <Icon
      size="1em"
      stroke-width="1.8"
      aria-hidden={decorative ? "true" : undefined}
      role={decorative ? undefined : "img"}
      aria-label={accessibleLabel}
      focusable="false"
    />
  </span>
) : !decorative && label ? (
  <span class="glyph-fallback">{label}</span>
) : null}
