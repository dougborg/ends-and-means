---
import {
  glyphs,
  type GlyphName,
} from "../lib/presentation-glyphs";

type Size = "small" | "medium" | "large";
type Tone = "default" | "accent" | "evidence" | "warning";
type Props =
  | {
      glyph?: GlyphName;
      decorative?: true;
      label?: never;
      size?: Size;
      tone?: Tone;
    }
  | {
      glyph?: GlyphName;
      decorative: false;
      label: string;
      size?: Size;
      tone?: Tone;
    };

const {
  glyph,
  decorative = true,
  label,
  size = "medium",
  tone = "default",
} = Astro.props;
const definition = glyph ? glyphs[glyph] : undefined;
const Icon = definition?.component;
const accessibleLabel = decorative ? undefined : label;
---

{Icon ? (
  <span
    class:list={["glyph", `glyph--${size}`, `glyph--${tone}`]}
    data-glyph={glyph}
    data-glyph-purpose={definition.purpose}
  >
    <Icon
      size="1em"
      stroke-width="1.8"
      aria-hidden={decorative ? "true" : undefined}
      role={decorative ? undefined : "img"}
      aria-label={accessibleLabel}
      focusable="false"
    />
  </span>
) : !decorative && label ? (
  <span class="glyph-fallback">{label}</span>
) : null}

<style is:global>
  .glyph-label {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .glyph {
    display: inline-grid;
    width: 1.15em;
    height: 1.15em;
    flex: none;
    place-items: center;
    color: var(--text);
    font-size: 1rem;
    line-height: 1;
  }

  .glyph > svg {
    display: block;
    width: 1em;
    height: 1em;
    overflow: visible;
    fill: none;
    stroke: currentColor;
  }

  .glyph--small {
    font-size: 0.8rem;
  }

  .glyph--large {
    font-size: 1.2rem;
  }

  .glyph--accent {
    color: var(--link);
  }

  .glyph--evidence {
    color: var(--evidence);
  }

  .glyph--warning {
    color: var(--caution);
  }

  .glyph-fallback {
    font-family: var(--font-apparatus);
    font-size: 0.72rem;
  }

  @media (forced-colors: active) {
    .glyph {
      color: CanvasText;
      forced-color-adjust: auto;
    }
  }

  @media print {
    .glyph {
      color: currentColor;
    }

    .glyph > svg {
      stroke-width: 2.2;
    }
  }
</style>
