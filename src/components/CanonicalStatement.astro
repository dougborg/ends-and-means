---
import { citationsFor, entityById } from "../lib/domain/canonical";
import type { Source, Statement } from "../lib/domain";

interface Props { statementId: string; label?: string; anchored?: boolean; }
const { statementId, label, anchored = true } = Astro.props;
const statement = entityById<Statement>(statementId);
if (statement?.kind !== "statement") throw new Error(`Unknown canonical Statement: ${statementId}`);
const citations = citationsFor(statementId).map((citation) => {
  const source = entityById<Source>(citation.object.id);
  const href = source?.resourceLinks?.[0]?.url;
  const reference = source ? [source.contributorDisplay?.join(", ") ?? source.label, source.publicationYear].filter(Boolean).join(", ") : "Unresolved source";
  return { citation, source, href, reference };
});
---
<article class="canonical-claim" id={anchored ? statement.id : undefined}>
  <p class="coordinate">{label ?? statement.statementKind.replaceAll("-", " ")}</p>
  <p class="canonical-claim__text">{statement.text}</p>
  <footer>
    <span class="claim-status">{statement.publicationStatus === "reviewed" ? "Claim reviewed" : "Research needed"}</span>
    <ol aria-label="Sources">
      {citations.map(({ citation, source, href, reference }) => source && (
        <li>
          {href ? <a href={href}>{reference}</a> : <span>{reference}</span>}
          <span>{citation.locator} · {citation.role}</span>
        </li>
      ))}
    </ol>
  </footer>
</article>
