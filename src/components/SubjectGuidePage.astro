---
import type {
  DomainRelationship,
  Dossier,
  NarrativeSection,
  ResearchObligation,
  SubjectGuide,
  SubjectGuideSection,
} from "../lib/domain";
import { publicRelationshipLabel } from "../lib/domain";
import { canonicalGraph, entityById } from "../lib/domain/canonical";
import { glyphForSubjectGuideSection } from "../lib/presentation-glyphs";
import { hrefForEntity } from "../lib/public-routes";
import {
  directSubjectGuideEvidence,
  visibleSubjectGuideSections,
} from "../lib/subject-guide-presentation";
import CanonicalStatement from "./CanonicalStatement.astro";
import Glyph from "./Glyph.astro";
import MarkdownProse from "./MarkdownProse.astro";
import OnPageNavigation from "./OnPageNavigation.astro";
import ResearchObligationCard from "./ResearchObligationCard.astro";
import SubjectGuideRelationshipDetails from "./SubjectGuideRelationshipDetails.astro";

interface Props {
  guide: SubjectGuide;
}

const { guide } = Astro.props;

function dossierFor(id: string) {
  const entity = entityById(id);
  return entity?.kind === "dossier" ? entity : undefined;
}

type NarrativeSelection =
  | { narrative: Dossier; standfirst: true }
  | { narrative: NarrativeSection; standfirst: false };

function selectedNarrative(
  section: SubjectGuideSection,
): NarrativeSelection[] {
  const selections: NarrativeSelection[] = [];
  for (const reference of section.narrativeRefs ?? []) {
    const dossier = dossierFor(reference.dossierId);
    if (!dossier) continue;
    if (reference.sectionId === undefined) {
      selections.push({ narrative: dossier, standfirst: true });
      continue;
    }
    const narrative = dossier.sections.find(({ id }) => id === reference.sectionId);
    if (narrative) selections.push({ narrative, standfirst: false });
  }
  return selections;
}

function narrativeBody(
  selection: ReturnType<typeof selectedNarrative>[number],
) {
  return selection.standfirst
    ? selection.narrative.standfirst
    : selection.narrative.body;
}

function narrativeStatementIds(
  selection: ReturnType<typeof selectedNarrative>[number],
) {
  return selection.standfirst
    ? selection.narrative.standfirstStatementIds
    : selection.narrative.statementIds;
}

const relationshipsById = new Map(
  canonicalGraph.relationships.map((relationship) => [relationship.id, relationship]),
);

function selectedRelationship(id: string) {
  return relationshipsById.get(id);
}

function relationshipEnds(relationship: DomainRelationship) {
  return {
    subject: entityById(relationship.subject.id),
    object: entityById(relationship.object.id),
  };
}

function placementValueLabel(
  relationship: Extract<DomainRelationship, { predicate: "placed-on" }>,
) {
  const dimension = entityById(relationship.object.id);
  if (dimension?.kind !== "comparison-dimension") return undefined;
  const label = (id: string) => dimension.values.find((value) => value.id === id)?.label;
  const value = relationship.value.kind === "category"
    ? label(relationship.value.categoryId)
    : [label(relationship.value.fromCategoryId), label(relationship.value.toCategoryId)]
      .filter(Boolean)
      .join(" to ");
  return value || undefined;
}

function selectedObligation(id: string) {
  const entity = entityById(id);
  return entity?.kind === "research-obligation" ? entity : undefined;
}

const shortAnswer = guide.sections.find(({ role }) => role === "short-answer");
const journeySections = visibleSubjectGuideSections(guide).filter(
  ({ role }) => role !== "short-answer",
);
const primary = entityById(guide.primarySubject.id);
const primaryHref = hrefForEntity(guide.primarySubject);
const shortAnswerSelections = shortAnswer ? selectedNarrative(shortAnswer) : [];
const outlineItems = [
  { id: "short-answer", label: shortAnswer?.heading ?? `About ${guide.label}` },
  ...journeySections.map(({ id, heading }) => ({ id, label: heading })),
];
const referenceLink = primary && primaryHref
  ? { href: primaryHref, label: `Open the ${primary.label} reference page` }
  : undefined;
const anchoredObligationIds = new Set<string>();
const anchoredStatementIds = new Set<string>();

function ownsStatementAnchor(id: string) {
  if (anchoredStatementIds.has(id)) return false;
  anchoredStatementIds.add(id);
  return true;
}

function ownsObligationAnchor(id: string) {
  if (anchoredObligationIds.has(id)) return false;
  anchoredObligationIds.add(id);
  return true;
}
---

<article class="subject-guide">
  <nav class="subject-guide__breadcrumb" aria-label="Breadcrumb">
    <a href="/explore/">Explore</a><span aria-hidden="true">/</span><span aria-current="page">{guide.label}</span>
  </nav>

  <section class="subject-guide__hero" id="short-answer" aria-label={outlineItems[0]?.label}>
    <p class="coordinate">LEARN ABOUT</p>
    <h1>{guide.label}</h1>
    {shortAnswerSelections.map((selection) => (
      <div class="subject-guide__answer">
        <MarkdownProse content={narrativeBody(selection)} />
        {narrativeStatementIds(selection).length > 0 && (
          <details class="reference-disclosure subject-guide__evidence">
            <summary>
              Sources for the short answer
              <span>{narrativeStatementIds(selection).length} {narrativeStatementIds(selection).length === 1 ? "claim" : "claims"}</span>
            </summary>
            <div class="reference-disclosure__body">
              {narrativeStatementIds(selection).map((id) => <CanonicalStatement statementId={id} anchored={ownsStatementAnchor(id)} />)}
            </div>
          </details>
        )}
      </div>
    ))}
  </section>

  <div class="subject-guide__layout">
    <OnPageNavigation
      pageLabel={guide.label}
      items={outlineItems}
      {...(referenceLink ? { referenceLink } : {})}
    />

    <div class="subject-guide__journey">
      {journeySections.map((section) => {
        const narratives = selectedNarrative(section);
        const relationships = (section.relationshipIds ?? [])
          .map(selectedRelationship)
          .filter((relationship): relationship is DomainRelationship => Boolean(relationship));
        const obligations = (section.researchObligationIds ?? [])
          .map(selectedObligation)
          .filter((obligation): obligation is ResearchObligation => Boolean(obligation));
        return (
          <section id={section.id} class:list={["subject-guide__section", `subject-guide__section--${section.role}`]}>
            <header>
              <p class="coordinate glyph-label"><Glyph glyph={glyphForSubjectGuideSection(section.role)} size="large" tone={section.role === "bounded-practice" ? "evidence" : section.role === "open-questions" || section.role === "variants-and-disputes" ? "warning" : "accent"} />QUESTION</p>
              <h2>{section.heading}</h2>
            </header>

            {narratives.map((selection) => {
              const statementIds = narrativeStatementIds(selection);
              const evidenceSubject = selection.standfirst
                ? section.heading
                : selection.narrative.heading;
              return (
                <div class="subject-guide__passage">
                  <MarkdownProse content={narrativeBody(selection)} />
                  {statementIds.length > 0 && (
                    <details class="reference-disclosure subject-guide__evidence">
                      <summary>Sources for “{evidenceSubject}” <span>{statementIds.length} {statementIds.length === 1 ? "claim" : "claims"}</span></summary>
                      <div class="reference-disclosure__body">
                        {statementIds.map((id) => <CanonicalStatement statementId={id} anchored={ownsStatementAnchor(id)} />)}
                      </div>
                    </details>
                  )}
                </div>
              );
            })}

            {directSubjectGuideEvidence(section).length > 0 && (
              <details class="reference-disclosure subject-guide__evidence subject-guide__direct-evidence">
                <summary>Sources for selected claims in “{section.heading}” <span>{directSubjectGuideEvidence(section).length}</span></summary>
                <div class="reference-disclosure__body">
                  {directSubjectGuideEvidence(section).map((id) => <CanonicalStatement statementId={id} anchored={ownsStatementAnchor(id)} />)}
                </div>
              </details>
            )}

            {(section.entityRefs?.length ?? 0) > 0 && (
              <ul class="subject-guide__links" aria-label={`Continue from ${section.heading}`}>
                {section.entityRefs?.map((reference) => {
                  const entity = entityById(reference.id);
                  const href = hrefForEntity(reference);
                  return entity && (
                    <li>
                      <span>{entity.kind.replaceAll("-", " ")}</span>
                      {href ? <a href={href}>{entity.label}</a> : <strong>{entity.label}</strong>}
                      <p>{entity.description}</p>
                    </li>
                  );
                })}
              </ul>
            )}

            {relationships.length > 0 && (
              <section class="subject-guide__relationships" aria-labelledby={`${section.id}-connections`}>
                <h3 class="sr-only" id={`${section.id}-connections`}>Connections for {section.heading}</h3>
                {relationships.map((relationship) => {
                  const { subject, object } = relationshipEnds(relationship);
                  const subjectHref = hrefForEntity(relationship.subject);
                  const objectHref = hrefForEntity(relationship.object);
                  return subject && object && (
                    <article data-relationship-id={relationship.id}>
                      <p>
                        {subjectHref ? <a href={subjectHref}>{subject.label}</a> : <strong>{subject.label}</strong>}
                        <span>{publicRelationshipLabel(relationship, "subject")}</span>
                        {objectHref ? <a href={objectHref}>{object.label}</a> : <strong>{object.label}</strong>}
                      </p>
                      <SubjectGuideRelationshipDetails
                        relationship={relationship}
                        summary={`How to read the connection between ${subject.label} and ${object.label}`}
                        entityLabel={(id) => entityById(id)?.label}
                        {...(relationship.predicate === "placed-on"
                          ? { placementValueLabel: () => placementValueLabel(relationship) }
                          : {})}
                      />
                      {"statementIds" in relationship && relationship.statementIds.length > 0 && (
                        <details class="reference-disclosure subject-guide__evidence">
                          <summary>Sources for the connection between {subject.label} and {object.label} <span>{relationship.statementIds.length} {relationship.statementIds.length === 1 ? "claim" : "claims"}</span></summary>
                          <div class="reference-disclosure__body">
                            {relationship.statementIds.map((id) => <CanonicalStatement statementId={id} anchored={ownsStatementAnchor(id)} />)}
                          </div>
                        </details>
                      )}
                    </article>
                  );
                })}
              </section>
            )}

            {obligations.length > 0 && (
              <ol class="subject-guide__questions">
                {obligations.map((obligation) => (
                  <ResearchObligationCard
                    obligation={obligation}
                    anchored={ownsObligationAnchor(obligation.id)}
                  />
                ))}
              </ol>
            )}
          </section>
        );
      })}
    </div>
  </div>
</article>
