---
import { isCurrentPublicRoute, publicRoutes } from "../lib/public-navigation";
interface Props { currentPath?: string; }
const { currentPath = "/" } = Astro.props;
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="wordmark" href="/" aria-label="Ends and Means, home"><span>Ends</span><span class="wordmark__hinge">and</span><span>Means</span></a>
    <nav aria-label="Primary">
      <ul class="primary-nav">
        {publicRoutes.map((route) => <li><a href={route.href} aria-current={isCurrentPublicRoute(currentPath, route) ? "page" : undefined}>{route.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>
