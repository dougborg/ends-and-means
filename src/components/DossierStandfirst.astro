---
import CanonicalStatement from "./CanonicalStatement.astro";
import MarkdownProse from "./MarkdownProse.astro";

interface Props { content: string; statementIds?: string[] | undefined; }
const { content, statementIds = [] } = Astro.props;
---

<div class="dossier-standfirst">
  <MarkdownProse className="dek" content={content} />
  {statementIds.length > 0 && (
    <details class="standfirst-evidence reference-disclosure">
      <summary>How this summary is supported <span>{statementIds.length} {statementIds.length === 1 ? "claim" : "claims"}</span></summary>
      <div class="reference-disclosure__body">{statementIds.map((id) => <CanonicalStatement statementId={id} />)}</div>
    </details>
  )}
</div>
