---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
interface Props { title?: string; description?: string; currentPath?: string; eyebrow?: string; fullBleed?: boolean; }
const { title, description = "Political and economic systems in theory and practice.", currentPath = Astro.url.pathname, fullBleed = false } = Astro.props;
const pageTitle = title ? `${title} — Ends and Means` : "Ends and Means";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader currentPath={currentPath} />
    <main id="main-content" class:list={["site-main", { "site-main--wide": fullBleed }]}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
