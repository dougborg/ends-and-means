---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EvidenceBadge from "../../components/EvidenceBadge.astro";
import {
  cellHref,
  cells,
  cellsForCrux,
  cellsForSystem,
  cruxHref,
  getCrux,
  getSystem,
  sourcesForCell,
  systemHref,
} from "../../lib/routes/reference";
import type { Cell, Source } from "../../lib/content/model";

export function getStaticPaths() {
  return cells.map((cell) => ({
    params: { id: cell.id },
    props: { cell, sources: sourcesForCell(cell) },
  }));
}

interface Props {
  cell: Cell;
  sources: Source[];
}

const { cell, sources } = Astro.props;
const system = getSystem(cell.system);
const crux = getCrux(cell.crux);
const sameCrux = cellsForCrux(cell.crux).filter((neighbor) => neighbor.id !== cell.id);
const sameSystem = cellsForSystem(cell.system).filter((neighbor) => neighbor.id !== cell.id);
---

<BaseLayout title={`${system.name}: ${crux.title}`} description={cell.mechanism} currentPath={`/cells/${cell.id}/`} eyebrow={`Cell / ${cell.id.toUpperCase()}`}>
  <div class="reference-page">
    <nav aria-label="Breadcrumb"><a href="/">Ends and Means</a> / Comparison cell</nav>
    <header>
      <p class="coordinate">CELL / {cell.id.toUpperCase()}</p>
      <h1>{system.name}</h1>
      <p class="dek">On <a href={cruxHref(crux)}>{crux.title}</a>: {crux.question}</p>
      <p><a href={systemHref(system)}>View {system.name} across every crux</a></p>
    </header>

    <article>
      <p class="coordinate">VERDICT / {cell.verdict}</p>
      {cell.evidence === "none" ? <span>No evidence linked</span> : <EvidenceBadge state={cell.evidence} />}
      <section aria-labelledby="mechanism-heading">
        <h2 id="mechanism-heading">How it works</h2>
        <p>{cell.mechanism || "No mechanism description has been added yet."}</p>
      </section>
      <section aria-labelledby="breaks-heading">
        <h2 id="breaks-heading">Where it breaks</h2>
        <p>{cell.breaks || "No limitations have been documented yet."}</p>
      </section>
      <section aria-labelledby="evidence-heading">
        <h2 id="evidence-heading">Sources and cases</h2>
        {sources.length ? (
          <ul>{sources.map((source) => <li>{source.authors.join(", ")}, <cite>{source.title}</cite>{source.year ? ` (${source.year})` : ""}</li>)}</ul>
        ) : (
          <p>No sources are linked to this cell yet.{cell.needsCitation ? " This comparison needs citation." : ""}</p>
        )}
        {cell.cases.length ? <p>Cases: {cell.cases.join(", ")}</p> : <p>No cases are linked to this cell yet.</p>}
      </section>
    </article>

    <nav aria-label="Neighboring comparison cells">
      <h2>Keep comparing</h2>
      <h3>Other systems on {crux.title}</h3>
      <ul>
        {sameCrux.map((neighbor) => <li><a href={cellHref(neighbor)}>{getSystem(neighbor.system).name}</a></li>)}
      </ul>
      <h3>Other cruxes for {system.name}</h3>
      <ul>
        {sameSystem.map((neighbor) => <li><a href={cellHref(neighbor)}>{getCrux(neighbor.crux).title}</a></li>)}
      </ul>
    </nav>
  </div>
</BaseLayout>
