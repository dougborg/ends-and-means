---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { systemHref, systems } from "../../lib/routes/reference";
---

<BaseLayout title="Systems" description="Political and economic systems examined across a shared set of contested questions." currentPath="/systems/" eyebrow="Reference / Systems">
  <header>
    <p class="coordinate">REFERENCE / {systems.length} SYSTEMS</p>
    <h1>Systems</h1>
    <p class="dek">Each dossier follows one system across the same fourteen cruxes, making its mechanisms, tradeoffs, and evidence easier to compare.</p>
  </header>
  <nav aria-label="System dossiers">
    <ol class="reference-list">
      {systems.map((system) => (
        <li>
          <p class="coordinate">SYSTEM / {system.id.toUpperCase()}</p>
          <h2><a href={systemHref(system)}>{system.name}</a></h2>
          <p>{system.description}</p>
        </li>
      ))}
    </ol>
  </nav>
</BaseLayout>
