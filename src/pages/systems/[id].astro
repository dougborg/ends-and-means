---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EvidenceBadge from "../../components/EvidenceBadge.astro";
import {
  cellHref,
  casesForCells,
  cellsForSystem,
  cruxHref,
  graph,
  sourcesForCells,
  systems,
} from "../../lib/routes/reference";
import type { Case, Cell, Source, System } from "../../lib/content/model";

export function getStaticPaths() {
  return systems.map((system) => {
    const cells = cellsForSystem(system.id);
    return {
      params: { id: system.id },
      props: {
        system,
        cells,
        sources: sourcesForCells(cells),
        cases: casesForCells(cells),
      },
    };
  });
}

interface Props {
  system: System;
  cells: Cell[];
  sources: Source[];
  cases: Case[];
}

const { system, cells, sources, cases } = Astro.props;
---

<BaseLayout title={system.name} description={system.description} currentPath={`/systems/${system.id}/`} eyebrow={`System / ${system.id.toUpperCase()}`} fullBleed>
  <div class="reference-page">
    <nav aria-label="Breadcrumb"><a href="/">Ends and Means</a> / Systems</nav>
    <header>
      <p class="coordinate">SYSTEM / {system.id.toUpperCase()}</p>
      <h1>{system.name}</h1>
      <p class="dek">{system.description}</p>
    </header>

    <div class="reference-layout">
      <article aria-labelledby="positions-heading">
        <h2 id="positions-heading">Across the cruxes</h2>
        <ol class="reference-list">
          {cells.map((cell) => {
            const crux = graph.cruxes.find((item) => item.id === cell.crux)!;
            return (
              <li>
                <p class="coordinate">{crux.id} / {cell.verdict}</p>
                <h3><a href={cellHref(cell)}>{crux.title}</a></h3>
                {cell.evidence === "none" ? <span>No evidence linked</span> : <EvidenceBadge state={cell.evidence} />}
                <p>{cell.mechanism || "No mechanism description has been added yet."}</p>
                <p><strong>Where it breaks:</strong> {cell.breaks || "No limitations have been documented yet."}</p>
                <p><a href={cruxHref(crux)}>Compare all systems on this crux</a></p>
              </li>
            );
          })}
        </ol>
      </article>

      <aside aria-labelledby="evidence-heading">
        <h2 id="evidence-heading">Evidence used here</h2>
        <h3>Sources</h3>
        {sources.length ? (
          <ul>
            {sources.map((source) => <li>{source.authors.join(", ")}, <cite>{source.title}</cite>{source.year ? ` (${source.year})` : ""}</li>)}
          </ul>
        ) : (
          <p>No sources are linked to this system’s comparison cells yet. Evidence labels describe the current editorial assessment, not a completed bibliography.</p>
        )}
        <h3>Cases</h3>
        {cases.length ? (
          <ul>{cases.map((caseStudy) => <li><strong>{caseStudy.name}</strong>{caseStudy.dates ? ` (${caseStudy.dates})` : ""}: {caseStudy.summary}</li>)}</ul>
        ) : (
          <p>No case studies are linked to this system’s comparison cells yet.</p>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>
