---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EvidenceBadge from "../../components/EvidenceBadge.astro";
import {
  cellHref,
  cellsForCrux,
  cruxes,
  getSystem,
  systemHref,
} from "../../lib/routes/reference";
import type { Cell, Crux } from "../../lib/content/model";

export function getStaticPaths() {
  return cruxes.map((crux) => ({
    params: { id: crux.id },
    props: { crux, cells: cellsForCrux(crux.id) },
  }));
}

interface Props {
  crux: Crux;
  cells: Cell[];
}

const { crux, cells } = Astro.props;
---

<BaseLayout title={crux.title} description={crux.question} currentPath={`/cruxes/${crux.id}/`} eyebrow={`Crux / ${crux.id.toUpperCase()}`} fullBleed>
  <div class="reference-page">
    <nav aria-label="Breadcrumb"><a href="/">Ends and Means</a> / Cruxes</nav>
    <header>
      <p class="coordinate">CRUX / {crux.id.toUpperCase()}</p>
      <h1>{crux.title}</h1>
      <p class="dek">{crux.question}</p>
      {crux.valueLaden && <p><strong>Value-laden question:</strong> evaluating this crux necessarily involves judgments about which outcomes matter and how tradeoffs should be weighed.</p>}
      {crux.note && <p>{crux.note}</p>}
    </header>

    <section aria-labelledby="systems-heading">
      <h2 id="systems-heading">How the systems respond</h2>
      <ol class="reference-list">
        {cells.map((cell) => {
          const system = getSystem(cell.system);
          return (
            <li>
              <p class="coordinate">{system.id.toUpperCase()} / {cell.verdict}</p>
              <h3><a href={cellHref(cell)}>{system.name}</a></h3>
              {cell.evidence === "none" ? <span>No evidence linked</span> : <EvidenceBadge state={cell.evidence} />}
              <p>{cell.mechanism || "No mechanism description has been added yet."}</p>
              <p><strong>Where it breaks:</strong> {cell.breaks || "No limitations have been documented yet."}</p>
              <p><a href={systemHref(system)}>Read this system across every crux</a></p>
            </li>
          );
        })}
      </ol>
    </section>
  </div>
</BaseLayout>
