---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { cruxHref, cruxes } from "../../lib/routes/reference";
---

<BaseLayout title="Cruxes" description="The contested questions used to compare every system on common ground." currentPath="/cruxes/" eyebrow="Reference / Cruxes">
  <header>
    <p class="coordinate">REFERENCE / {cruxes.length} CRUXES</p>
    <h1>Cruxes</h1>
    <p class="dek">A crux is a question on which systems make meaningfully different choices—not a scorecard category with a neutral answer.</p>
  </header>
  <nav aria-label="Crux dossiers">
    <ol class="reference-list">
      {cruxes.map((crux) => (
        <li>
          <p class="coordinate">CRUX / {crux.id.toUpperCase()}{crux.valueLaden ? " / VALUE-LADEN" : ""}</p>
          <h2><a href={cruxHref(crux)}>{crux.title}</a></h2>
          <p>{crux.question}</p>
        </li>
      ))}
    </ol>
  </nav>
</BaseLayout>
