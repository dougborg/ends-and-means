---
import BaseLayout from "../layouts/BaseLayout.astro";
import { entitiesOfKind } from "../lib/domain/canonical";
import "../styles/homepage.css";
const approaches = entitiesOfKind("approach");
const featuredApproach = approaches[0];
---
<BaseLayout fullBleed mainClass="homepage" description="Explore evidence-backed political-economic approaches, institutions, cases, and comparisons.">
  <header class="homepage-hero">
    <p class="coordinate">ENDS AND MEANS / SYSTEMS IN THEORY AND PRACTICE</p>
    <div class="homepage-hero__thesis"><h1>Follow the claim<br /><span>from purpose to practice.</span></h1><p class="dek">Explore what an approach values, the institutions it proposes, what happened in bounded cases, and which judgments the evidence can—or cannot—support.</p></div>
    {featuredApproach && <aside class="homepage-hero__guide" aria-label="Featured approach"><p class="coordinate">FEATURED APPROACH</p><p>{featuredApproach.description}</p><a href={`/explore/${featuredApproach.id}/`}>Explore {featuredApproach.label} <span aria-hidden="true">→</span></a></aside>}
  </header>
  <section class="canonical-launch" aria-labelledby="canonical-launch-title">
    <header><p class="coordinate">EXPLORE / CASES / COMPARE</p><h2 id="canonical-launch-title">Three ways into the evidence</h2></header>
    <div>
      <article><p class="coordinate">01 / EXPLORE</p><h3>Approaches and institutions</h3><p>Trace attributed Ends through proposed Means, Challenges, and sourced Statements.</p><a href="/explore/">Browse approaches →</a></article>
      <article><p class="coordinate">02 / CASES</p><h3>Bounded practice</h3><p>Keep formal design, rules in use, observed outcomes, and interpretation visibly separate.</p><a href="/cases/">Browse the case directory →</a></article>
      <article><p class="coordinate">03 / COMPARE</p><h3>Claims in the same frame</h3><p>Compare sourced Statements and placements without manufacturing a score or duplicating prose.</p><a href="/compare/">Open Compare →</a></article>
    </div>
  </section>
  <section class="secondary-discovery" aria-labelledby="catalogue-title">
    <header><p class="coordinate">PUBLISHED RESEARCH</p><h2 id="catalogue-title">Research you can inspect.</h2><p>Every published dossier is built from the same evidence model of independently addressable claims, sources, institutions, and bounded cases.</p></header>
    <div class="secondary-discovery__paths">
      <article><p class="coordinate">METHOD</p><h3>How the evidence model works</h3><p>See why Concepts, Approaches, Means, Cases, Statements, and Sources remain distinct.</p><a href="/framework/">Read the method <span aria-hidden="true">→</span></a></article>
      <article><p class="coordinate">READING</p><h3>Sources behind published claims</h3><p>Browse the works actually connected to published Statements.</p><a href="/reading/">Open the reading directory <span aria-hidden="true">→</span></a></article>
    </div>
  </section>
</BaseLayout>
