---
import BaseLayout from "../layouts/BaseLayout.astro";
import framework from "../../content/framework/draft.json";
import "../styles/traditions-entry.css";

const challengeCount = new Map(framework.traditions.map((tradition) => [
  tradition.id,
  framework.responses.filter(({ traditionId }) => traditionId === tradition.id).length,
]));
---
<BaseLayout fullBleed description="Explore political-economic traditions and ideal types through their defining commitments, institutional responses, disputes, and open research questions.">
  <header class="traditions-hero">
    <p class="coordinate">ENDS AND MEANS / COMPARATIVE FIELD GUIDE</p>
    <div class="traditions-hero__thesis">
      <h1>How different systems<br /><span>organize common life.</span></h1>
      <p class="dek">Begin with a political-economic tradition. Each dossier asks what it values, which institutions it relies on, how it responds to recurring problems, and where its record remains contested.</p>
    </div>
    <aside class="traditions-hero__guide" aria-label="How to use this guide">
      <p class="coordinate">A NOTE ON THE LABELS</p>
      <p>These are families of ideas and analytical ideal types—not boxes that whole countries fit neatly inside. Each overview names its boundaries and internal tensions.</p>
      <a href="/framework/">Read the method <span aria-hidden="true">→</span></a>
    </aside>
  </header>

  <section class="tradition-catalogue" aria-labelledby="tradition-catalogue-title">
    <header class="tradition-catalogue__heading">
      <div>
        <p class="coordinate">PRIMARY ENTRY POINT / 8 DOSSIERS</p>
        <h2 id="tradition-catalogue-title">Traditions and ideal types</h2>
      </div>
      <p>Read an orientation, clarify common misconceptions, then follow its proposed Means across the same set of Challenges.</p>
    </header>
    <ol class="tradition-cards">
      {framework.traditions.map((tradition) => (
        <li>
          <article class="tradition-card">
            <header>
              <p class="tradition-card__kind">Working dossier</p>
              <h3><a href={`/traditions/${tradition.id}/`}>{tradition.name}</a></h3>
            </header>
            <p class="tradition-card__summary">{tradition.overview[0]}</p>
            <div class="tradition-card__boundary">
              <span>Keep in view</span>
              <p>{tradition.distinctions[0]}</p>
            </div>
            <footer>
              <span>{challengeCount.get(tradition.id)} Challenge responses</span>
              <a href={`/traditions/${tradition.id}/`} aria-label={`Open the ${tradition.name} dossier`}>Open dossier <span aria-hidden="true">→</span></a>
            </footer>
          </article>
        </li>
      ))}
    </ol>
  </section>

  <section class="secondary-discovery" aria-labelledby="compare-title">
    <header>
      <p class="coordinate">COMPARE ACROSS TRADITIONS</p>
      <h2 id="compare-title">Start somewhere else</h2>
      <p>Already have a question in mind? Approach the same material through a recurring institutional Challenge or a broad Topic.</p>
    </header>
    <div class="secondary-discovery__paths">
      <article>
        <p class="coordinate">9 QUESTIONS</p>
        <h3>Challenges</h3>
        <p>Compare how every tradition responds to coordination, power, security, transition, and other recurring problems.</p>
        <a href="/challenges/">Browse all Challenges <span aria-hidden="true">→</span></a>
      </article>
      <article>
        <p class="coordinate">5 LENSES</p>
        <h3>Topics</h3>
        <p>Follow related questions through Ownership, Work, Security, Coordination, and Power.</p>
        <a href="/topics/">Browse all Topics <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>

  <aside class="homepage-draft-note">
    <p class="coordinate">RESEARCH STATUS</p>
    <p><strong>This is a working research draft.</strong> The dossiers establish a clearer structure for inquiry; inherited assertions remain marked for sourcing and review rather than presented as settled conclusions.</p>
    <a href="/reading/">Inspect the reading directory <span aria-hidden="true">→</span></a>
  </aside>
</BaseLayout>
