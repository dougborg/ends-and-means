---
import { readFile } from "node:fs/promises";
import path from "node:path";
import EvidenceBadge from "../components/EvidenceBadge.astro";
import VerificationBadge from "../components/VerificationBadge.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

type DiagnosticReport = Record<string, unknown>;

const reportCandidates = [
  "generated/reports/import-report.json",
  "generated/diagnostic-report.json",
  "generated/report.json",
  "src/generated/diagnostic-report.json",
];

let report: DiagnosticReport | undefined;
let reportPath: string | undefined;

for (const candidate of reportCandidates) {
  try {
    report = JSON.parse(
      await readFile(path.join(process.cwd(), candidate), "utf8"),
    ) as DiagnosticReport;
    reportPath = candidate;
    break;
  } catch (error) {
    if (!(error instanceof Error) || !("code" in error) || error.code !== "ENOENT") {
      throw error;
    }
  }
}
---

<BaseLayout fullBleed>
  <header class="masthead">
    <p class="coordinate">COMPARATIVE INSTRUMENT / OPEN WORK</p>
    <h1>Start with a problem,<br /><span>not an ideology.</span></h1>
    <div class="masthead__statement">
      <p>Political and economic systems promise different ends and depend on different means.</p>
      <p>Trace the tradeoffs, mechanisms, evidence, and historical record behind each claim.</p>
    </div>
  </header>

  <section class="instrument-panel" aria-labelledby="diagnostics-heading">
        <div class="section-heading">
          <div>
            <p class="coordinate">FOUNDATION / KNOWLEDGE GRAPH</p>
            <h2 id="diagnostics-heading">Research status</h2>
          </div>
          <div class="badge-row">
            <EvidenceBadge state={report ? "partial" : "untested"} />
            <VerificationBadge state={report ? "reviewed" : "draft"} />
          </div>
        </div>

        {
          report ? (
            <>
              <p class="report-source">Generated from <code>{reportPath}</code></p>
              <pre><code>{JSON.stringify(report, null, 2)}</code></pre>
            </>
          ) : (
            <div class="empty-state">
              <p>No generated diagnostic report exists yet.</p>
              <p>
                Run <code>npm run import</code>, then <code>npm run validate</code>.
                This page will expose the resulting graph report without requiring
                browser JavaScript.
              </p>
            </div>
          )
        }
  </section>
</BaseLayout>
