---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ExternalReferences from "../../components/ExternalReferences.astro";
import NarrativeDossier from "../../components/NarrativeDossier.astro";
import { dossierForSubject, entitiesOfKind, entityById, relationshipsTo } from "../../lib/domain/canonical";
import type { Approach, Concept } from "../../lib/domain";

export function getStaticPaths() { return entitiesOfKind("concept").map((concept) => ({ params: { id: concept.id }, props: { concept } })); }
const concept = Astro.props.concept as Concept;
const dossier = dossierForSubject("concept", concept.id);
const approaches = relationshipsTo(concept.id).filter((relation) => relation.predicate === "interprets-concept").map((relation) => ({ approach: entityById(relation.subject.id) as Approach | undefined, role: relation.role, interpretation: relation.interpretation, statementIds: relation.statementIds })).filter((value): value is { approach: Approach; role: "core" | "adjacent" | "peripheral" | "contested"; interpretation: string; statementIds: string[] } => Boolean(value.approach));
const narrativeSections = approaches.map(({ approach, interpretation, statementIds }) => ({ id: `used-by-${approach.id}`, heading: `How ${approach.label} uses the idea`, body: interpretation, traceStatus: "qualified" as const, statementIds, relatedEntityRefs: [{ kind: "approach" as const, id: approach.id }] }));
---
<BaseLayout title={concept.label} description={dossier?.standfirst ?? concept.description} fullBleed>
  <article class="concept-dossier canonical-dossier">
    <nav aria-label="Breadcrumb"><a href="/explore/">Explore</a> / Concept</nav>
    <header><p class="coordinate">CONCEPT</p><h1>{concept.label}</h1><p class="dek">{dossier?.standfirst ?? concept.description}</p></header>
    {narrativeSections.length > 0 && <NarrativeDossier sections={narrativeSections} label="How this idea is being used here" />}
    <section class="reference-apparatus" aria-labelledby="concept-reference-title"><header><p class="coordinate">REFERENCE</p><h2 id="concept-reference-title">Definition and orientation</h2></header><details class="apparatus-group"><summary>Scope and external references</summary><div class="apparatus-group__body apparatus-group__body--single"><p class="scope-note"><strong>Scope note:</strong> {concept.scopeNote}</p><ExternalReferences references={concept.externalRefs} /></div></details></section>
  </article>
</BaseLayout>
