---
import prototype from "../../../prototypes/analytical-framework/prototype.json";

const challenge = prototype.challenges[0]!;
const caseOne = prototype.cases[0]!;
const caseTwo = prototype.cases[1]!;
const trace = prototype.traces[0]!;
const assessment = trace.assessments[0]!;
const criterion = prototype.criteria.find(({ id }) => id === assessment.criterionId) ?? prototype.criteria[0]!;
const sources = new Map(prototype.sources.map((source) => [source.id, source]));
const outcome = caseTwo.outcomes.find(({ id }) => id === "outcome-limited-control")!;
const interpretations = prototype.interpretations.filter(({ target }) => target.id === outcome.id);
const end = prototype.ends[0]!;
const endAttribution = end.attributions[0]!;
const means = prototype.means[0]!;
const practice = caseOne.interactionPatterns[0]!;
const firstOutcome = caseOne.outcomes[0]!;
const criterionCitation = assessment.citations[0]!;
const assessmentCitation = assessment.citations[1]!;
const formalRule = caseTwo.formalRules[0]!;
const ruleInUse = caseTwo.rulesInUse[0]!;

const stages = [
  {
    id: "end",
    marker: "E",
    label: "End",
    title: end.label,
    text: endAttribution.text,
    meta: "Declared · LO program · Sweden, 1951–1983",
    sourceId: endAttribution.citations[0]!.sourceId,
    locator: endAttribution.citations[0]!.locator,
  },
  {
    id: "means",
    marker: "M",
    label: "Means",
    title: "Solidaristic wage bargaining",
    text: means.text,
    meta: "Collective-choice rule · aggregation",
    sourceId: means.citations[0]!.sourceId,
    locator: means.citations[0]!.locator,
  },
  {
    id: "practice",
    marker: "P",
    label: "Practice",
    title: caseOne.name,
    text: practice.text,
    meta: `${caseOne.location} · ${caseOne.period.start}–${caseOne.period.end} · influenced by tradition`,
    sourceId: practice.citations[0]!.sourceId,
    locator: practice.citations[0]!.locator,
  },
  {
    id: "outcome",
    marker: "O",
    label: "Observed outcome",
    title: "Wage compression",
    text: firstOutcome.text,
    meta: "Sourced observation · uncertainty: moderate",
    sourceId: firstOutcome.citations[0]!.sourceId,
    locator: firstOutcome.citations[0]!.locator,
  },
  {
    id: "criterion",
    marker: "C",
    label: "Criterion",
    title: criterion.label,
    text: criterion.definition,
    meta: "Declared evaluative lens · not a score",
    sourceId: criterionCitation.sourceId,
    locator: criterionCitation.locator,
  },
  {
    id: "assessment",
    marker: "A",
    label: "Assessment",
    title: "What this evidence supports",
    text: assessment.text,
    meta: "Inference · uncertainty: high",
    sourceId: assessmentCitation.sourceId,
    locator: assessmentCitation.locator,
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta name="description" content="A visual prototype for the Ends and Means analytical framework." />
    <title>Analytical trace prototype — Ends and Means</title>
  </head>
  <body>
    <a class="skip-link" href="#trace">Skip to the argument trace</a>
    <header class="prototype-header">
      <a class="wordmark" href="/" aria-label="Ends and Means home">
        <span>Ends</span><i>and</i><span>Means</span>
      </a>
      <p><span>Prototype 01</span> Analytical response trace</p>
      <nav aria-label="Prototype sections">
        <a href="#trace">Trace</a>
        <a href="#case">Case</a>
        <a href="#compare">Compare</a>
      </nav>
    </header>

    <main>
      <section class="intro" aria-labelledby="page-title">
        <div class="intro__index" aria-hidden="true">E / M</div>
        <div>
          <p class="kicker">Challenge · distribution of gains and ownership</p>
          <h1 id="page-title">{challenge.question}</h1>
        </div>
        <div class="intro__context">
          <p>Two institutional responses, examined in bounded Swedish cases.</p>
          <dl>
            <div><dt>Tradition</dt><dd>{prototype.tradition.label}</dd></div>
            <div><dt>Relationship</dt><dd>Partial and contested</dd></div>
            <div><dt>Evidence</dt><dd>Statement by statement</dd></div>
          </dl>
        </div>
      </section>

      <section class="workbench" id="trace" aria-labelledby="trace-title">
        <header class="workbench__header">
          <div>
            <p class="kicker">Response trace 01</p>
            <h2 id="trace-title">Solidaristic wage bargaining</h2>
          </div>
          <p class="scope"><span>Scope</span> Sweden · 1951–1983</p>
        </header>

        <div class="trace-layout">
          <nav class="trace-nav" aria-label="Argument stages">
            <p class="apparatus-title">Argument trace</p>
            <ol>
              {stages.map((stage, index) => (
                <li>
                  <button type="button" class:list={["trace-node", { "is-active": index === 0 }]} data-stage={stage.id} aria-pressed={index === 0 ? "true" : "false"}>
                    <span class="trace-node__mark" aria-hidden="true">{stage.marker}</span>
                    <span><small>{stage.label}</small>{stage.title}</span>
                  </button>
                </li>
              ))}
            </ol>
          </nav>

          <article class="argument" aria-live="polite">
            {stages.map((stage, index) => (
              <section class:list={["argument-stage", { "is-active": index === 0 }]} data-panel={stage.id} hidden={index !== 0}>
                <p class="kicker">{stage.label}</p>
                <h3>{stage.title}</h3>
                <p class="argument-stage__statement">{stage.text}</p>
                <p class="argument-stage__meta">{stage.meta}</p>
                {stage.id === "assessment" && (
                  <p class="caution"><span aria-hidden="true">◇</span> This assessment does not establish a reduction in private wealth concentration.</p>
                )}
              </section>
            ))}

            <div class="trace-overview" aria-label="Complete linear trace">
              <p class="apparatus-title">Complete trace</p>
              <ol>
                {stages.map((stage) => <li><span>{stage.label}</span>{stage.title}</li>)}
              </ol>
            </div>
          </article>

          <aside class="evidence" aria-labelledby="evidence-title">
            <div class="evidence__state"><span aria-hidden="true"></span> Source checked</div>
            <h3 id="evidence-title">Evidence for this statement</h3>
            {stages.map((stage, index) => {
              const source = sources.get(stage.sourceId)!;
              return (
                <div class:list={["evidence-panel", { "is-active": index === 0 }]} data-evidence={stage.id} hidden={index !== 0}>
                  <p class="source-title">{source.authors.join(", ")}</p>
                  <p><cite>{source.title}</cite> ({source.year})</p>
                  <p class="locator">Locator · {stage.locator}</p>
                  <a href={source.url}>Open source <span aria-hidden="true">↗</span></a>
                  <hr />
                  <dl>
                    <div><dt>Claim type</dt><dd>{stage.id === "end" ? "Sourced attribution" : stage.id === "assessment" ? "Inference" : "Sourced statement"}</dd></div>
                    <div><dt>Scope</dt><dd>Sweden · bounded period</dd></div>
                    <div><dt>Uncertainty</dt><dd>{stage.id === "assessment" ? "High" : "Moderate"}</dd></div>
                  </dl>
                  <button class="text-action" type="button">Suggest a correction</button>
                </div>
              );
            })}
          </aside>
        </div>
      </section>

      <section class="case-study" id="case" aria-labelledby="case-title">
        <header>
          <div>
            <p class="kicker">Bounded case · Sweden · {caseTwo.period.start}–{caseTwo.period.end}</p>
            <h2 id="case-title">{caseTwo.name}</h2>
          </div>
          <p class="case-status">Relationship to tradition<br /><strong>{caseTwo.traditionRelationship.relation}</strong></p>
        </header>
        <p class="case-boundary">{caseTwo.boundary}</p>
        <div class="case-grid">
          <section>
            <p class="apparatus-title">Context and participants</p>
            <h3>Conditions shape the institution</h3>
            <ul class="plain-list">
              {caseTwo.context.materialConditions.map((item) => <li>{item}</li>)}
              {caseTwo.context.communityAttributes.map((item) => <li>{item}</li>)}
            </ul>
            <div class="participants">
              {caseTwo.participants.map((participant) => <span>{participant.label}</span>)}
            </div>
          </section>
          <section class="rule-stack">
            <p class="apparatus-title">Institution in practice</p>
            <div class="rule-block">
              <small>Formal rule</small>
              <h3>Funding and voting caps</h3>
              <p>{formalRule.text}</p>
            </div>
            <div class="rule-connector"><span>in use</span></div>
            <div class="rule-block rule-block--practice">
              <small>Observed practice</small>
              <h3>Conventional investor behavior</h3>
              <p>{ruleInUse.text}</p>
            </div>
          </section>
        </div>
      </section>

      <section class="comparison" id="compare" aria-labelledby="compare-title">
        <header>
          <p class="kicker">Comparison · accountability criterion</p>
          <h2 id="compare-title">The same limit can mean different things.</h2>
          <p>{outcome.text}</p>
        </header>
        <div class="interpretation-fork">
          <div class="fork-origin"><span>Observed outcome</span><strong>Limited fund control</strong></div>
          <div class="fork-branches">
            {interpretations.map((item) => (
              <article>
                <p class="interpretation-position">{item.position}</p>
                <h3>{item.text}</h3>
                <p>{item.reasoning}</p>
                <p class="attribution">— {item.attributedTo.join(", ")}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="prototype-note">
        <p class="kicker">What this prototype tests</p>
        <p>The trace is navigation, evidence is attached to individual statements, cases declare their boundaries, and disagreement remains visible. Nothing here produces a score or treats Sweden as an instance of a single system.</p>
        <a href="https://github.com/dougborg/ends-and-means/issues/38">Follow the framework discussion <span aria-hidden="true">↗</span></a>
      </section>
    </main>

    <footer><p>Ends and Means · visual framework prototype</p><p>Research fixture · not canonical content</p></footer>

    <script>
      const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-stage]")];
      const setStage = (id: string) => {
        buttons.forEach((button) => {
          const active = button.dataset.stage === id;
          button.classList.toggle("is-active", active);
          button.setAttribute("aria-pressed", String(active));
        });
        document.querySelectorAll<HTMLElement>("[data-panel]").forEach((panel) => {
          const active = panel.dataset.panel === id;
          panel.hidden = !active;
          panel.classList.toggle("is-active", active);
        });
        document.querySelectorAll<HTMLElement>("[data-evidence]").forEach((panel) => {
          const active = panel.dataset.evidence === id;
          panel.hidden = !active;
          panel.classList.toggle("is-active", active);
        });
      };
      buttons.forEach((button) => button.addEventListener("click", () => setStage(button.dataset.stage!)));
    </script>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..700&family=Literata:opsz,wght@7..72,400..600&family=IBM+Plex+Mono:wght@400;500&display=swap');
  :root { color-scheme: light; --night:#17232b; --ink:#263941; --muted:#587078; --atmosphere:#edf4f5; --sheet:#fff; --cobalt:#2556d8; --teal:#087e72; --teal-wash:#e2f3ef; --amber:#a85f08; --amber-wash:#fff3d5; --rule:#b8c9ce; --display:"Bricolage Grotesque",sans-serif; --reading:"Literata",serif; --mono:"IBM Plex Mono",monospace; }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; background:var(--atmosphere); }
  body { margin:0; min-width:20rem; overflow-x:hidden; color:var(--night); font-family:var(--display); }
  button,a { font:inherit; }
  a { color:var(--cobalt); text-underline-offset:.22em; }
  :focus-visible { outline:3px solid var(--cobalt); outline-offset:3px; }
  .skip-link { position:fixed; z-index:20; top:1rem; left:1rem; padding:.7rem 1rem; color:white; background:var(--night); transform:translateY(-200%); }
  .skip-link:focus { transform:none; }
  .prototype-header, main, footer { width:min(92rem,calc(100% - clamp(2rem,6vw,6rem))); margin-inline:auto; }
  .prototype-header { display:grid; grid-template-columns:1fr auto 1fr; min-height:5.25rem; align-items:center; border-bottom:1px solid var(--rule); }
  .wordmark { display:flex; gap:.26em; align-items:baseline; width:max-content; color:var(--night); font-size:1.15rem; font-weight:700; letter-spacing:-.04em; text-decoration:none; }
  .wordmark i { color:var(--cobalt); font-family:var(--reading); font-size:.72em; font-weight:400; }
  .prototype-header p { margin:0; color:var(--muted); font:500 .68rem/1.4 var(--mono); letter-spacing:.06em; text-transform:uppercase; }
  .prototype-header p span { color:var(--cobalt); }
  .prototype-header nav { display:flex; justify-content:flex-end; gap:1.4rem; }
  .prototype-header nav a { color:var(--night); font-size:.82rem; font-weight:600; text-decoration:none; }
  main { padding-bottom:6rem; }
  .intro { display:grid; grid-template-columns:5rem minmax(0,1.5fr) minmax(17rem,.6fr); gap:2rem; align-items:end; padding:clamp(4rem,9vw,8.5rem) 0 clamp(3rem,7vw,6rem); }
  .intro__index { align-self:start; color:var(--cobalt); font:500 .78rem/1 var(--mono); writing-mode:vertical-rl; }
  .kicker,.apparatus-title { margin:0 0 .75rem; color:var(--cobalt); font:500 .68rem/1.45 var(--mono); letter-spacing:.09em; text-transform:uppercase; }
  h1,h2,h3,p { margin-top:0; }
  h1 { max-width:20ch; margin:0; font-size:clamp(2.6rem,6vw,5.7rem); font-weight:600; letter-spacing:-.065em; line-height:.98; text-wrap:balance; }
  h2 { margin:0; font-size:clamp(1.65rem,3vw,2.9rem); font-weight:600; letter-spacing:-.045em; line-height:1.05; }
  .intro__context { max-width:29rem; font-family:var(--reading); font-size:.92rem; line-height:1.6; }
  .intro__context>p { font-size:1.06rem; }
  dl { margin:0; }
  dl div { display:grid; grid-template-columns:7rem 1fr; gap:1rem; padding:.55rem 0; border-top:1px solid var(--rule); }
  dt { color:var(--muted); font:500 .64rem/1.45 var(--mono); letter-spacing:.06em; text-transform:uppercase; }
  dd { margin:0; }
  .workbench { border-top:4px solid var(--night); background:var(--sheet); box-shadow:0 1.5rem 5rem rgb(23 35 43 / 9%); }
  .workbench__header,.case-study>header { display:flex; justify-content:space-between; gap:2rem; align-items:end; padding:clamp(1.5rem,3vw,2.5rem); border-bottom:1px solid var(--rule); }
  .scope { margin:0; color:var(--muted); font:400 .72rem/1.5 var(--mono); text-align:right; }
  .scope span { display:block; color:var(--cobalt); text-transform:uppercase; }
  .trace-layout { display:grid; grid-template-columns:minmax(13rem,.72fr) minmax(21rem,1.5fr) minmax(17rem,.7fr); min-height:39rem; }
  .trace-nav { padding:2rem 1.5rem; border-right:1px solid var(--rule); }
  .trace-nav ol { margin:1.5rem 0 0; padding:0; list-style:none; }
  .trace-nav li { position:relative; padding-bottom:.35rem; }
  .trace-nav li:not(:last-child)::after { position:absolute; z-index:0; top:2.35rem; bottom:-.15rem; left:1rem; width:1px; background:var(--rule); content:""; }
  .trace-node { position:relative; z-index:1; display:grid; grid-template-columns:2rem 1fr; gap:.75rem; width:100%; padding:.5rem 0; border:0; color:var(--muted); background:transparent; text-align:left; cursor:pointer; }
  .trace-node__mark { display:grid; width:2rem; height:2rem; place-items:center; border:1px solid var(--rule); border-radius:50%; background:var(--sheet); font:500 .66rem/1 var(--mono); }
  .trace-node small { display:block; margin-bottom:.2rem; font:500 .57rem/1.2 var(--mono); letter-spacing:.08em; text-transform:uppercase; }
  .trace-node.is-active { color:var(--night); }
  .trace-node.is-active .trace-node__mark { border-color:var(--cobalt); color:white; background:var(--cobalt); box-shadow:0 0 0 4px #e2e8fb; }
  .argument { display:flex; flex-direction:column; min-width:0; padding:clamp(2rem,5vw,5rem); }
  .argument-stage { margin:auto 0; }
  .argument-stage h3 { max-width:16ch; margin-bottom:1.5rem; font-size:clamp(2rem,4vw,4.4rem); font-weight:600; letter-spacing:-.06em; line-height:.98; text-wrap:balance; }
  .argument-stage__statement { max-width:36ch; font:500 clamp(1.08rem,1.6vw,1.38rem)/1.55 var(--reading); }
  .argument-stage__meta { margin-top:2rem; color:var(--muted); font:400 .68rem/1.6 var(--mono); }
  .caution { max-width:42rem; padding:1rem; border-left:3px solid var(--amber); background:var(--amber-wash); font:400 .86rem/1.55 var(--reading); }
  .trace-overview { margin-top:auto; padding-top:2rem; }
  .trace-overview ol { display:grid; grid-template-columns:repeat(6,minmax(5rem,1fr)); margin:0; padding:0; border-top:1px solid var(--rule); list-style:none; }
  .trace-overview li { padding:.7rem .5rem 0 0; color:var(--muted); font-size:.64rem; line-height:1.35; }
  .trace-overview li span { display:block; color:var(--cobalt); font:500 .55rem/1.4 var(--mono); text-transform:uppercase; }
  .evidence { padding:2rem 1.5rem; border-left:1px solid var(--rule); background:#f8fbfb; font-family:var(--reading); font-size:.84rem; line-height:1.58; }
  .evidence__state { display:flex; gap:.55rem; align-items:center; margin-bottom:3rem; color:var(--teal); font:500 .64rem/1.4 var(--mono); text-transform:uppercase; }
  .evidence__state span { width:.65rem; height:.65rem; border:2px solid var(--teal); transform:rotate(45deg); background:var(--teal); }
  .evidence h3 { font-family:var(--display); font-size:1.15rem; }
  .source-title { margin-bottom:.2rem; font-weight:600; }
  .locator { color:var(--muted); font:400 .66rem/1.5 var(--mono); }
  .evidence hr { margin:1.7rem 0; border:0; border-top:1px solid var(--rule); }
  .evidence dl div { grid-template-columns:5.5rem 1fr; }
  .text-action { margin-top:1.5rem; padding:.65rem 0; border:0; border-bottom:1px solid currentColor; color:var(--cobalt); background:transparent; font-size:.8rem; font-weight:600; cursor:pointer; }
  .argument-stage.is-active,.evidence-panel.is-active { animation:reveal .28s ease-out; }
  .case-study,.comparison { margin-top:clamp(5rem,10vw,10rem); border-top:4px solid var(--night); background:var(--sheet); }
  .case-status { margin:0; color:var(--muted); font:400 .65rem/1.55 var(--mono); text-align:right; text-transform:uppercase; }
  .case-status strong { color:var(--amber); font-weight:500; }
  .case-boundary { margin:0; padding:1.15rem clamp(1.5rem,3vw,2.5rem); border-bottom:1px solid var(--rule); color:var(--muted); background:#f7fafb; font:400 .76rem/1.55 var(--mono); }
  .case-grid { display:grid; grid-template-columns:.7fr 1.3fr; }
  .case-grid>section { padding:clamp(2rem,5vw,4rem); }
  .case-grid>section+section { border-left:1px solid var(--rule); }
  .case-grid h3 { max-width:20ch; font-size:1.6rem; }
  .plain-list { margin:1.5rem 0; padding:0; list-style:none; font:400 .92rem/1.65 var(--reading); }
  .plain-list li { padding:.75rem 0; border-top:1px solid var(--rule); }
  .participants { display:flex; flex-wrap:wrap; gap:.45rem; }
  .participants span { padding:.4rem .55rem; border:1px solid var(--rule); font:400 .62rem/1.3 var(--mono); }
  .rule-stack { display:flex; flex-direction:column; }
  .rule-block { max-width:42rem; padding:1.5rem; border:1px solid var(--rule); }
  .rule-block small,.fork-origin span { color:var(--cobalt); font:500 .62rem/1.4 var(--mono); text-transform:uppercase; }
  .rule-block h3 { margin:.55rem 0 1rem; }
  .rule-block p { margin:0; font:400 .92rem/1.65 var(--reading); }
  .rule-block--practice { margin-left:clamp(2rem,8vw,7rem); border-color:var(--teal); }
  .rule-connector { height:3.5rem; margin-left:clamp(3rem,12vw,10rem); border-left:1px solid var(--teal); }
  .rule-connector span { padding-left:.6rem; color:var(--teal); font:400 .58rem/1.4 var(--mono); text-transform:uppercase; }
  .comparison { padding:clamp(2rem,5vw,5rem); }
  .comparison>header { max-width:56rem; }
  .comparison>header h2 { max-width:20ch; }
  .comparison>header>p:last-child { max-width:46rem; margin:1.5rem 0 0; font:400 1rem/1.65 var(--reading); }
  .interpretation-fork { display:grid; grid-template-columns:14rem 1fr; gap:0 4rem; margin-top:4rem; }
  .fork-origin { position:relative; align-self:center; padding:1.25rem; border:1px solid var(--rule); }
  .fork-origin::after { position:absolute; top:50%; left:100%; width:4rem; border-top:1px solid var(--amber); content:""; }
  .fork-origin span { display:block; margin-bottom:.5rem; color:var(--amber); }
  .fork-branches { display:grid; gap:1rem; }
  .fork-branches article { position:relative; padding:1.5rem 2rem; border-left:2px solid var(--amber); background:var(--amber-wash); }
  .fork-branches article::before { position:absolute; top:50%; right:100%; width:2rem; border-top:1px solid var(--amber); content:""; }
  .interpretation-position,.attribution { color:var(--amber); font:500 .61rem/1.4 var(--mono); text-transform:uppercase; }
  .fork-branches h3 { max-width:46rem; font:500 1.1rem/1.5 var(--reading); }
  .fork-branches article>p:not(.interpretation-position):not(.attribution) { max-width:50rem; color:var(--muted); font:400 .84rem/1.6 var(--reading); }
  .prototype-note { display:grid; grid-template-columns:12rem minmax(0,1fr) auto; gap:2rem; align-items:start; margin-top:6rem; padding-top:1.5rem; border-top:1px solid var(--rule); }
  .prototype-note>p:nth-child(2) { max-width:47rem; font:400 1rem/1.65 var(--reading); }
  .prototype-note>a { font-size:.8rem; font-weight:600; }
  footer { display:flex; justify-content:space-between; padding:2rem 0; border-top:1px solid var(--rule); color:var(--muted); font:400 .65rem/1.5 var(--mono); }
  footer p { margin:0; }
  [hidden] { display:none !important; }
  @keyframes reveal { from { opacity:0; transform:translateY(.4rem); } to { opacity:1; transform:none; } }
  @media (max-width:72rem) {
    .trace-layout { grid-template-columns:13rem 1fr; }
    .evidence { grid-column:2; border-top:1px solid var(--rule); border-left:0; }
    .evidence__state { margin-bottom:1.5rem; }
    .intro { grid-template-columns:3rem 1fr; }
    .intro__context { grid-column:2; }
  }
  @media (max-width:48rem) {
    .prototype-header { grid-template-columns:auto minmax(0,1fr); gap:1rem; padding:.8rem 0; }
