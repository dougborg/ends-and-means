---
import Glyph from "../../components/Glyph.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { canonicalGraph, dossierForSubject, entitiesOfKind, entityById } from "../../lib/domain/canonical";
import { nonBrowseGuidesDiscoveredAt } from "../../lib/explore-discovery";

const cases = entitiesOfKind("case");
const focusedGuides = nonBrowseGuidesDiscoveredAt(canonicalGraph.subjectGuides, "/cases/");
---
<BaseLayout title="Cases" description="Time- and place-bounded political-economic cases." fullBleed>
  <article class="canonical-index"><header><p class="coordinate">CASES / EVIDENCE IN CONTEXT</p><h1>A place is not a system. A period is not forever.</h1><p class="dek measure-standfirst">Cases preserve the institutional setting in which claims were observed. Episodes keep materially different arrangements from collapsing into a country label.</p></header><ol class="canonical-directory">{cases.map((item) => <li><p class="coordinate glyph-label"><Glyph glyph="bounded-practice" tone="evidence" />{item.startDate.year}–{item.endDate?.year ?? "ongoing"}</p><h2><a href={`/cases/${item.id}/`}>{item.label}</a></h2><p>{dossierForSubject("case", item.id)?.standfirst ?? item.description}</p><p><strong>Location:</strong> {item.locationIds.map((id) => entityById(id)?.label).join(", ")}</p></li>)}</ol>{focusedGuides.length > 0 && <section class="reference-apparatus" aria-labelledby="focused-case-guides"><header><p class="coordinate">FOCUSED GUIDES</p><h2 id="focused-case-guides">Read a bounded case as a guided question</h2><p>These guides connect cases and evidence without treating a place or period as a complete political system.</p></header><ul>{focusedGuides.map(({ guide }) => <li><a href={`/guides/${guide.slug}/`}>{guide.label}</a></li>)}</ul></section>}</article>
</BaseLayout>
