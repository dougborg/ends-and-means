---
import CanonicalStatement from "../../components/CanonicalStatement.astro";
import DossierStandfirst from "../../components/DossierStandfirst.astro";
import ExternalReferences from "../../components/ExternalReferences.astro";
import NarrativeDossier from "../../components/NarrativeDossier.astro";
import OpenResearchQuestions from "../../components/OpenResearchQuestions.astro";
import RelatedIdeas from "../../components/RelatedIdeas.astro";
import TransitionPanel from "../../components/TransitionPanel.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Approach, Case, CaseEpisode, Concept, Criterion } from "../../lib/domain";
import { dossierForSubject, entitiesOfKind, entityById, relationshipsFrom } from "../../lib/domain/canonical";
export function getStaticPaths() { return entitiesOfKind("case").map((item) => ({ params: { id: item.id }, props: { item } })); }
const item = Astro.props.item as Case;
const dossier = dossierForSubject("case", item.id);
const episodes = item.episodeIds.map((id) => entityById(id) as CaseEpisode | undefined).filter((value): value is CaseEpisode => Boolean(value));
const episodeViews = episodes.map((episode) => ({ episode, assessments: relationshipsFrom(episode.id).filter((relation) => relation.predicate === "assessed-by").map((relation) => ({ criterion: entityById(relation.object.id) as Criterion | undefined, conclusion: relation.conclusion, statementIds: relation.statementIds })) }));
const transitions = entitiesOfKind("transition").filter((transition) => transition.caseId === item.id);
const approachIds = new Set(episodes.flatMap((episode) => relationshipsFrom(episode.id)).filter((relation) => relation.predicate !== "cites" && ["self-identified-with", "influenced-by", "partially-instantiated", "hybridized-with", "departed-from"].includes(relation.predicate)).map((relation) => relation.object.id));
const approaches = [...approachIds].map((id) => entityById(id)).filter((value): value is Approach => value?.kind === "approach");
const hasComparison = episodes.some((episode) => relationshipsFrom(episode.id).some(({ predicate }) => predicate === "placed-on"));
const relatedIdeas = [...approachIds].flatMap((approachId) => relationshipsFrom(approachId)).filter((relation) => relation.predicate === "interprets-concept").map((relation) => ({ concept: entityById(relation.object.id) as Concept | undefined, role: relation.role, interpretation: relation.interpretation })).filter((value): value is { concept: Concept; role: "core" | "adjacent" | "peripheral" | "contested"; interpretation: string } => Boolean(value.concept)).sort((a, b) => ["core", "adjacent", "contested", "peripheral"].indexOf(a.role) - ["core", "adjacent", "contested", "peripheral"].indexOf(b.role));
---
<BaseLayout title={item.label} description={dossier?.standfirst ?? item.description} fullBleed>
  <article class="canonical-dossier case-dossier"><nav aria-label="Breadcrumb"><a href="/cases/">Cases</a> / {item.endDate ? "Historical case" : "Ongoing case"}</nav><header><p class="coordinate">CASE / {item.startDate.year}–{item.endDate?.year ?? "ongoing"}</p><h1>{item.label}</h1><DossierStandfirst content={dossier?.standfirst ?? item.description} statementIds={dossier?.standfirstStatementIds} /></header>
    {dossier && <NarrativeDossier sections={dossier.sections} label="Case summary" />}
    <OpenResearchQuestions kind="case" id={item.id} />
    <section class="reference-apparatus" aria-labelledby="case-reference-title"><header><p class="coordinate">REFERENCE</p><h2 id="case-reference-title">Inspect the case record</h2><p>Open the boundaries, related ideas, and institutional evidence behind the summary.</p></header>
    <details class="apparatus-group"><summary>Scope, related ideas, and external orientation</summary><div class="apparatus-group__body"><div><p class="scope-note"><strong>Boundary:</strong> {item.scope}</p><p class="scope-note"><strong>Why this case:</strong> {item.selectionRationale}</p></div><div><RelatedIdeas ideas={relatedIdeas} /><ExternalReferences references={item.externalRefs} /></div></div></details>
    {episodeViews.map(({ episode, assessments }) => <><details class="apparatus-group" id={episode.id}><summary>{episode.label} <span>{episode.startDate.year}–{episode.endDate?.year}</span></summary><div class="apparatus-group__body apparatus-group__body--single"><section class="episode"><p>{episode.scope}</p><div class="evidence-columns"><section><h3>Formal design</h3>{episode.formalRuleStatementIds.map((id) => <CanonicalStatement statementId={id} />)}</section><section><h3>Rules in use</h3>{episode.ruleInUseStatementIds.map((id) => <CanonicalStatement statementId={id} />)}</section><section><h3>Observed outcomes</h3>{episode.outcomeStatementIds.map((id) => <CanonicalStatement statementId={id} />)}</section></div>{assessments.length > 0 && <section class="case-assessments"><p class="coordinate">Criterion-specific assessments</p>{assessments.map(({ criterion, conclusion, statementIds }) => criterion && <article><h3>{criterion.label}<small>{conclusion}</small></h3><div>{statementIds.map((id) => <CanonicalStatement statementId={id} />)}</div></article>)}</section>}</section></div></details>{transitions.filter((transition) => transition.fromEpisodeIds.includes(episode.id)).map((transition) => <details class="apparatus-group"><summary>Change over time: {transition.label}</summary><div class="apparatus-group__body apparatus-group__body--single"><TransitionPanel transition={transition} /></div></details>)}</>)}
    </section>
    {(approaches.length > 0 || hasComparison) && <nav class="next-actions" aria-label="Continue">{approaches.map((approach) => <a href={`/explore/${approach.id}/`}>Return to {approach.label}</a>)}{hasComparison && <a href="/compare/">Compare promise and practice</a>}</nav>}
  </article>
</BaseLayout>
