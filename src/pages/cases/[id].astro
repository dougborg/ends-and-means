---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CanonicalStatement from "../../components/CanonicalStatement.astro";
import ExternalReferences from "../../components/ExternalReferences.astro";
import RelatedIdeas from "../../components/RelatedIdeas.astro";
import TransitionPanel from "../../components/TransitionPanel.astro";
import { citationsFor, dossierForSubject, entitiesOfKind, entityById, relationshipsFrom } from "../../lib/domain/canonical";
import type { Approach, Case, CaseEpisode, Concept, Criterion, Source } from "../../lib/domain";
export function getStaticPaths() { return entitiesOfKind("case").map((item) => ({ params: { id: item.id }, props: { item } })); }
const item = Astro.props.item as Case;
const dossier = dossierForSubject("case", item.id);
const episodes = item.episodeIds.map((id) => entityById(id) as CaseEpisode | undefined).filter((value): value is CaseEpisode => Boolean(value));
const episodeViews = episodes.map((episode) => ({ episode, assessments: relationshipsFrom(episode.id).filter((relation) => relation.predicate === "assessed-by").map((relation) => ({ criterion: entityById(relation.object.id) as Criterion | undefined, conclusion: relation.conclusion, statementIds: relation.statementIds })) }));
const transitions = entitiesOfKind("transition").filter((transition) => transition.caseId === item.id);
const overview = (dossier?.sections ?? []).map((section) => ({ ...section, sources: [...new Map(section.statementIds.flatMap((id) => citationsFor(id)).map((citation) => { const source = entityById(citation.object.id) as Source | undefined; return source ? [source.id, source] : undefined; }).filter((entry): entry is [string, Source] => Boolean(entry))).values()] }));
const approachIds = new Set(episodes.flatMap((episode) => relationshipsFrom(episode.id)).filter((relation) => relation.predicate !== "cites" && ["self-identified-with", "influenced-by", "partially-instantiated", "hybridized-with", "departed-from"].includes(relation.predicate)).map((relation) => relation.object.id));
const approaches = [...approachIds].map((id) => entityById(id)).filter((value): value is Approach => value?.kind === "approach");
const hasComparison = episodes.some((episode) => relationshipsFrom(episode.id).some(({ predicate }) => predicate === "placed-on"));
const relatedIdeas = [...approachIds].flatMap((approachId) => relationshipsFrom(approachId)).filter((relation) => relation.predicate === "interprets-concept").map((relation) => ({ concept: entityById(relation.object.id) as Concept | undefined, role: relation.role, interpretation: relation.interpretation })).filter((value): value is { concept: Concept; role: "core" | "adjacent" | "peripheral" | "contested"; interpretation: string } => Boolean(value.concept)).sort((a, b) => ["core", "adjacent", "contested", "peripheral"].indexOf(a.role) - ["core", "adjacent", "contested", "peripheral"].indexOf(b.role));
---
<BaseLayout title={item.label} description={dossier?.standfirst ?? item.description} fullBleed>
  <article class="canonical-dossier case-dossier"><nav aria-label="Breadcrumb"><a href="/cases/">Cases</a> / {item.endDate ? "Historical case" : "Ongoing case"}</nav><header><p class="coordinate">CASE / {item.startDate.year}–{item.endDate?.year ?? "ongoing"}</p><h1>{item.label}</h1><p class="dek">{dossier?.standfirst ?? item.description}</p><div class="case-header__metadata"><RelatedIdeas ideas={relatedIdeas} /><ExternalReferences references={item.externalRefs} /></div></header>
    {dossier && <section class="case-overview"><header><p class="coordinate">IN PLAIN TERMS</p><h2>Case overview</h2></header><div>{overview.map((section) => <article><p class="coordinate">{section.traceStatus.replaceAll("-", " ")}</p><h3>{section.heading}</h3><p>{section.body}</p>{section.sources.length > 0 && <footer><strong>References</strong>{section.sources.map((source) => { const href = source.resourceLinks?.[0]?.url; const label = [source.contributorDisplay?.join(", ") ?? source.label, source.publicationYear].filter(Boolean).join(", "); return href ? <a href={href}>{label}</a> : <span>{label}</span>; })}</footer>}</article>)}</div></section>}
    <div class="case-context"><p class="scope-note"><strong>Boundary:</strong> {item.scope}</p><p class="scope-note"><strong>Why this case:</strong> {item.selectionRationale}</p></div>
    {episodeViews.map(({ episode, assessments }) => <><section class="episode"><header><p class="coordinate">CASE EPISODE / {episode.startDate.year}–{episode.endDate?.year}</p><h2>{episode.label}</h2><p>{episode.scope}</p></header><div class="evidence-columns"><section><h3>Formal design</h3>{episode.formalRuleStatementIds.map((id) => <CanonicalStatement statementId={id} />)}</section><section><h3>Rules in use</h3>{episode.ruleInUseStatementIds.map((id) => <CanonicalStatement statementId={id} />)}</section><section><h3>Observed outcomes</h3>{episode.outcomeStatementIds.map((id) => <CanonicalStatement statementId={id} />)}</section></div>{assessments.length > 0 && <section class="case-assessments"><p class="coordinate">CRITERION-SPECIFIC ASSESSMENTS</p>{assessments.map(({ criterion, conclusion, statementIds }) => criterion && <article><h3>{criterion.label}<small>{conclusion}</small></h3><div>{statementIds.map((id) => <CanonicalStatement statementId={id} />)}</div></article>)}</section>}</section>{transitions.filter((transition) => transition.fromEpisodeIds.includes(episode.id)).map((transition) => <TransitionPanel transition={transition} />)}</>)}
    {(approaches.length > 0 || hasComparison) && <nav class="next-actions" aria-label="Continue">{approaches.map((approach) => <a href={`/explore/${approach.id}/`}>Return to {approach.label}</a>)}{hasComparison && <a href="/compare/">Compare promise and practice</a>}</nav>}
  </article>
</BaseLayout>
