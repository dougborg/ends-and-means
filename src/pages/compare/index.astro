---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CanonicalStatement from "../../components/CanonicalStatement.astro";
import { entityById } from "../../lib/domain/canonical";
import type { Criterion } from "../../lib/domain";
const rows = [
  { question: "Who would gain ownership and influence?", promise: "funds-declared-ends", design: "funds-statutory-design", practice: "funds-limited-control", assessment: "funds-distribution-assessment", criterion: entityById("distribution") as Criterion },
  { question: "How would delegated power remain accountable?", promise: "funds-declared-ends", design: "funds-statutory-design", practice: "funds-practice", assessment: "funds-accountability-assessment", criterion: entityById("accountability") as Criterion },
];
---
<BaseLayout title="Compare" description="Compare Ends, institutional Means, bounded practice, and criterion-specific judgments." fullBleed>
  <article class="compare-page"><header><p class="coordinate">COMPARE / FIRST CANONICAL TRACE</p><h1>Do the Means deliver the Ends?</h1><p class="dek">This view compares different stages of one argument. It does not score a winner or treat the Swedish case as proof of a universal system.</p></header><div class="comparison-table" role="region" aria-label="Promise and practice comparison" tabindex="0"><table><thead><tr><th scope="col">Question</th><th scope="col">Attributed End</th><th scope="col">Formal Means</th><th scope="col">Observed practice</th><th scope="col">Criterion-specific reading</th></tr></thead><tbody>{rows.map((row) => <tr><th scope="row"><strong>{row.question}</strong><span>{row.criterion.label}</span></th><td><CanonicalStatement statementId={row.promise} /></td><td><CanonicalStatement statementId={row.design} /></td><td><CanonicalStatement statementId={row.practice} /></td><td><CanonicalStatement statementId={row.assessment} /></td></tr>)}</tbody></table></div><p class="comparison-caveat"><strong>Why no score?</strong> Distribution and accountability are different Criteria with disclosed assumptions. Evidence about one cannot silently answer the other.</p></article>
</BaseLayout>
