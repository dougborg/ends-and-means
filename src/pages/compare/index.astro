---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CanonicalStatement from "../../components/CanonicalStatement.astro";
import { placementsForDimension, requireEntityOfKind } from "../../lib/domain/canonical";
const distribution = requireEntityOfKind("distribution", "criterion");
const accountability = requireEntityOfKind("accountability", "criterion");
const rows = [
  { question: "Who would gain ownership and influence?", promise: "funds-declared-ends", design: "funds-statutory-design", practice: "funds-limited-control", assessment: "funds-distribution-assessment", criterion: distribution },
  { question: "How would delegated power remain accountable?", promise: "funds-declared-ends", design: "funds-statutory-design", practice: "funds-practice", assessment: "funds-accountability-assessment", criterion: accountability },
];
const dimension = requireEntityOfKind("collective-wage-earner-shareholding-authority", "comparison-dimension");
const placements = placementsForDimension(dimension.id);
const orderedValues = [...dimension.values].sort((left, right) => left.order - right.order);
const valueLabel = (placement: (typeof placements)[number]) => {
  const value = placement.value;
  if (value.kind === "category") return orderedValues.find(({ id }) => id === value.categoryId)?.label;
  const from = orderedValues.find(({ id }) => id === value.fromCategoryId)?.label;
  const to = orderedValues.find(({ id }) => id === value.toCategoryId)?.label;
  return `${from}–${to}`;
};
const scopeLabel = (placement: (typeof placements)[number]) => {
  const { startDate, endDate } = placement.scope;
  const dates = startDate === endDate ? startDate : [startDate, endDate].filter(Boolean).join("–");
  const places = (placement.scope.placeIds ?? []).map((id) => requireEntityOfKind(id, "place").label).join(", ");
  return [dates, places, placement.scope.note].filter(Boolean).join(" · ");
};
---
<BaseLayout title="Compare" description="Compare Ends, institutional Means, bounded practice, and criterion-specific judgments." fullBleed>
  <article class="compare-page"><header><p class="coordinate">COMPARE / EVIDENCE TRACE</p><h1>Do the Means deliver the Ends?</h1><p class="dek measure-standfirst">This view compares different stages of one argument. It does not score a winner or treat the Swedish case as proof of a universal system.</p></header><!-- biome-ignore lint/a11y/noNoninteractiveTabindex: Horizontally scrollable data tables must be keyboard-focusable. --><section class="comparison-table" aria-label="Promise and practice comparison" tabindex="0"><table><thead><tr><th scope="col">Question</th><th scope="col">Attributed End</th><th scope="col">Formal Means</th><th scope="col">Observed practice</th><th scope="col">Criterion-specific reading</th></tr></thead><tbody>{rows.map((row) => <tr><th scope="row"><strong>{row.question}</strong><span>{row.criterion.label}</span></th><td><CanonicalStatement statementId={row.promise} /></td><td><CanonicalStatement statementId={row.design} /></td><td><CanonicalStatement statementId={row.practice} /></td><td><CanonicalStatement statementId={row.assessment} /></td></tr>)}</tbody></table></section><p class="comparison-caveat"><strong>Why no score?</strong> Distribution and accountability are different Criteria with disclosed assumptions. Evidence about one cannot silently answer the other.</p>

  <section class="dimension-comparison" aria-labelledby="dimension-heading">
    <header><p class="coordinate">DESCRIPTIVE DIMENSION / ONE-DIMENSIONAL VIEW</p><h2 id="dimension-heading">{dimension.label}</h2><p>{dimension.definition}</p></header>
    <ol class="dimension-scale" aria-label="Ordered dimension categories">{orderedValues.map((value) => <li><strong>{value.label}</strong><span>{value.description}</span></li>)}</ol>
    <!-- biome-ignore lint/a11y/noNoninteractiveTabindex: Horizontally scrollable data tables must be keyboard-focusable. --><section class="dimension-table" aria-label={`${dimension.label} placements`} tabindex="0"><table><thead><tr><th scope="col">Bounded subject</th><th scope="col">Placement</th><th scope="col">Basis and scope</th><th scope="col">Uncertainty</th><th scope="col">Evidence</th></tr></thead><tbody>{placements.map((placement) => { const subject = requireEntityOfKind(placement.subject.id, placement.subject.kind); return <tr><th scope="row" data-label="Bounded subject">{subject.label}</th><td data-label="Placement"><strong>{valueLabel(placement)}</strong></td><td data-label="Basis and scope"><span class="placement-basis">{placement.basis.replaceAll("-", " ")}</span><p>{scopeLabel(placement)}</p></td><td data-label="Uncertainty">{placement.uncertainty}</td><td data-label="Evidence">{placement.statementIds.map((statementId) => <CanonicalStatement statementId={statementId} />)}</td></tr>; })}</tbody></table></section>
    <div class="dimension-method"><div><h3>Method</h3><p>{dimension.method}</p></div><div><h3>Analytical choices</h3><ul>{dimension.normativeChoices.map((choice) => <li>{choice}</li>)}</ul></div><div><h3>Limits</h3><ul>{dimension.limitations.map((limitation) => <li>{limitation}</li>)}</ul></div></div>
    <p class="comparison-caveat"><strong>Dimension, not Criterion.</strong> These placements describe bounded voting authority. They do not say whether that authority was desirable, accountable, effective, or distributively sufficient. Unplaced subjects remain missing—not halfway along the scale.</p>
  </section></article>
</BaseLayout>
