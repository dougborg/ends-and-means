---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { citationsFor, entitiesOfKind } from "../../lib/domain/canonical";
const sources = entitiesOfKind("source").sort((a, b) => (b.publicationYear ?? 0) - (a.publicationYear ?? 0) || a.title.localeCompare(b.title));
const usageCounts = new Map<string, number>();
for (const statement of entitiesOfKind("statement")) {
  for (const { object } of citationsFor(statement.id)) usageCounts.set(object.id, (usageCounts.get(object.id) ?? 0) + 1);
}
const usageCount = (sourceId: string) => usageCounts.get(sourceId) ?? 0;
---
<BaseLayout title="Reading" description="Sources connected to published claims in Ends and Means.">
  <article class="reading-page"><header><p class="coordinate">EVIDENCE / PUBLISHED SOURCES</p><h1>Read the sources behind the claims.</h1><p class="dek">These are the published source records. Claim counts show how each source is currently used; open a record for its bibliographic details and connections.</p></header><section class="reading-section" aria-labelledby="sources-title"><header><p class="coordinate">SOURCE DIRECTORY / {sources.length}</p><h2 id="sources-title">Published evidence</h2></header><ol>{sources.map((source) => { const count = usageCount(source.id); return <li><div><p class="source-authors">{source.contributorDisplay?.join(", ") ?? source.publisher ?? "Source record"}</p><h3><a href={`/sources/${source.id}/`}>{source.title}</a></h3></div><span class="source-state">{count} {count === 1 ? "claim" : "claims"}</span></li>; })}</ol></section></article>
</BaseLayout>
