---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { citationsFor, entitiesOfKind } from "../../lib/domain/canonical";
const sources = entitiesOfKind("source").sort((a, b) => (b.publicationYear ?? 0) - (a.publicationYear ?? 0) || a.title.localeCompare(b.title));
const usageCounts = new Map<string, number>();
for (const statement of entitiesOfKind("statement")) {
  for (const { object } of citationsFor(statement.id)) usageCounts.set(object.id, (usageCounts.get(object.id) ?? 0) + 1);
}
const usageCount = (sourceId: string) => usageCounts.get(sourceId) ?? 0;
---
<BaseLayout title="Reading" description="Read the books, articles, records, and other sources used to support claims in Ends and Means." fullBleed>
  <article class="editorial-page reading-page"><header class="editorial-header"><p class="coordinate">READING</p><h1>Reading</h1><p class="dek measure-standfirst">Browse the books, articles, laws, and records used across the site. The claim count shows where each source contributes evidence; open a source for bibliographic details and exact connections.</p></header><section class="reading-section" aria-labelledby="sources-title"><header><p class="coordinate">{sources.length} SOURCES</p><h2 id="sources-title">Which sources support the explanations?</h2></header><ol>{sources.map((source) => { const count = usageCount(source.id); return <li><div><p class="source-authors">{source.contributorDisplay?.join(", ") ?? source.publisher ?? "Source"}</p><h3><a href={`/sources/${source.id}/`}>{source.title}</a></h3></div><span class="source-state">Supports {count} {count === 1 ? "claim" : "claims"}</span></li>; })}</ol></section></article>
</BaseLayout>
