---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { entitiesOfKind, relationshipsTo } from "../../lib/domain/canonical";
import "../../styles/challenge-topic.css";
const challenges = entitiesOfKind("challenge");
---
<BaseLayout fullBleed title="Challenges" description="Recurring questions connected to published approaches and criteria.">
  <div class="framework-index challenge-topic-page"><header><p class="coordinate">PUBLISHED RESEARCH / CHALLENGES</p><h1>Questions institutions must answer.</h1><p class="dek measure-standfirst">Challenges are open problems. Each page shows only the approaches and evaluative Criteria explicitly connected by the evidence.</p></header><ol class="indexed-list">{challenges.map((challenge, index) => { const count = relationshipsTo(challenge.id).filter(({ predicate }) => predicate === "responds-to").length; return <li><span>{String(index + 1).padStart(2, "0")}</span><div><h2><a href={`/challenges/${challenge.id}/`}>{challenge.question}</a></h2><p>{challenge.rationale}</p></div><small>{count} {count === 1 ? "approach" : "approaches"}</small></li>; })}</ol></div>
</BaseLayout>
