---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { entitiesOfKind } from "../../lib/domain/canonical";
const criteria = entitiesOfKind("criterion");
---
<BaseLayout title="Method" description="How Ends and Means separates questions, institutional proposals, evidence, and evaluation.">
  <article class="method-page"><header><p class="coordinate">METHOD / EVIDENCE MODEL</p><h1>Separate the question, mechanism, evidence, and judgment.</h1><p class="dek">The method makes disagreements inspectable. It does not produce a score, flatten a country into one system, or treat a theoretical mechanism as an observed outcome.</p></header>
    <section class="method-sequence" aria-labelledby="sequence-title"><h2 id="sequence-title">The argument trace</h2><ol><li><strong>Challenge</strong><span>A recurring open question</span></li><li><strong>Attributed End</strong><span>What a specified actor sought</span></li><li><strong>Institutional Means</strong><span>Roles, rules, authority, and incentives</span></li><li><strong>Bounded Case</strong><span>What operated where, when, and for whom</span></li><li><strong>Observed outcome</strong><span>A sourced result with limits</span></li><li><strong>Criterion</strong><span>The disclosed lens used to assess it</span></li></ol></section>
    <section class="criteria-section" aria-labelledby="criteria-title"><header><p class="coordinate">EVALUATION</p><h2 id="criteria-title">Explicit Criteria</h2></header><div>{criteria.map((criterion) => <article><h3>{criterion.label}</h3><p>{criterion.definition}</p><dl><div><dt>Assumption</dt><dd>{criterion.normativeAssumptions.join(" ")}</dd></div><div><dt>Evidence needed</dt><dd>{criterion.evidenceRequirements.join(" ")}</dd></div><div><dt>Limit</dt><dd>{criterion.limitations.join(" ")}</dd></div></dl></article>)}</div></section>
    <section class="model-boundary"><p class="coordinate">HOW TO READ THE CATALOGUE</p><h2>Every page follows the evidence.</h2><p>Claims remain independently addressable and retain their sources, locators, scope, uncertainty, and relationship status. Missing coverage is left blank rather than converted into a conclusion.</p></section>
  </article>
</BaseLayout>
