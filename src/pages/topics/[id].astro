---
import BaseLayout from "../../layouts/BaseLayout.astro";
import framework from "../../../content/framework/draft.json";
import "../../styles/challenge-topic.css";
export function getStaticPaths() { return framework.topics.map((topic) => ({ params: { id: topic.id }, props: { topic } })); }
const { topic } = Astro.props;
const challenges = framework.challenges.filter(({ topicIds }) => topicIds.includes(topic.id));
const neighboringTopics = framework.topics.filter((candidate) => candidate.id !== topic.id && challenges.some(({ topicIds }) => topicIds.includes(candidate.id)));
---
<BaseLayout fullBleed title={topic.label} description={topic.description}>
  <article class="framework-index challenge-topic-page topic-detail"><nav aria-label="Breadcrumb"><a href="/topics/">Topics</a> <span aria-hidden="true">/</span> {topic.label}</nav><header><p class="coordinate">TOPIC / DISCOVERY LABEL</p><h1>{topic.label}</h1><p class="dek">{topic.description}</p></header>
    <nav class="page-contents" aria-labelledby="contents-title"><p class="coordinate" id="contents-title">ON THIS PAGE</p><ol><li><a href="#topic-overview">How to use this Topic</a></li><li><a href="#topic-challenges">Related Challenges</a></li>{neighboringTopics.length > 0 && <li><a href="#neighboring-topics">Overlapping Topics</a></li>}</ol></nav>
    <section class="topic-explainer" id="topic-overview" aria-labelledby="topic-overview-title"><div><p class="coordinate">ORIENTATION</p><h2 id="topic-overview-title">A route through the framework</h2></div><p>{topic.description} The questions below separate this broad concern into comparisons that can be applied consistently across traditions. Topic membership signals relevance, not a claim that the questions exhaust the subject.</p></section>
    <section aria-labelledby="topic-challenges"><header class="directory-heading"><p class="coordinate">RELATED OPEN QUESTIONS</p><h2 id="topic-challenges">Challenges connected to {topic.label.toLowerCase()}</h2><p>Each Challenge holds the question steady and compares draft responses across all {framework.traditions.length} traditions.</p></header><ol class="indexed-list">{challenges.map((challenge, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><div><h2><a href={`/challenges/${challenge.id}/`}>{challenge.question}</a></h2><p>{challenge.rationale}</p></div><small>{framework.responses.filter(({ challengeId }) => challengeId === challenge.id).length} draft responses</small></li>)}</ol></section>
    {neighboringTopics.length > 0 && <nav class="related-topic-nav" id="neighboring-topics" aria-labelledby="neighboring-title"><div><p class="coordinate">OVERLAPPING TOPICS</p><h2 id="neighboring-title">Continue through connected concerns</h2></div><ul>{neighboringTopics.map((neighbor) => <li><a href={`/topics/${neighbor.id}/`}><strong>{neighbor.label}</strong><span>{neighbor.description}</span></a></li>)}</ul></nav>}
    <aside class="research-caveat"><p class="coordinate">RESEARCH STATE</p><p>Topics and their relationships are editorial navigation choices. They will evolve as researched claims, cases, and interpretations expose missing questions or connections.</p></aside>
  </article>
</BaseLayout>
