exports[`foundational Theocracy guide > pins every Statement and precise citation in the evidence ledger 1`] = `
[
  {
    "citations": [
      {
        "locator": "pp. 1–2, historical meanings and modern forms",
        "role": "supports",
        "sourceId": "huzakai-theocracy-source",
      },
    ],
    "id": "theocracy-contested-family",
    "statementKind": "definition",
    "text": "Huzakai traces theocracy from a claim of divine rule to several arrangements in which religious authority is connected to government; the term does not identify one timeless institutional form.",
  },
  {
    "citations": [
      {
        "locator": "pp. 1–2, divine rule and priestly rule",
        "role": "supports",
        "sourceId": "huzakai-theocracy-source",
      },
    ],
    "id": "theocracy-hierocracy-boundary",
    "statementKind": "definition",
    "text": "A narrow hierocratic or ecclesiocratic use requires rule by a priestly body, while broader uses of theocracy also include divine-law authority or offices that combine religious and state jurisdiction.",
  },
  {
    "citations": [
      {
        "locator": "pp. 2–12, definition and four elements",
        "role": "supports",
        "sourceId": "hirschl-constitutional-theocracy-source",
      },
    ],
    "id": "theocracy-state-religion-boundary",
    "statementKind": "editorial-interpretation",
    "text": "Constitutional recognition or support of a religion does not establish which institutions can make, review, execute, or enforce public law.",
  },
  {
    "citations": [
      {
        "locator": "pp. 2–12, constitutional status and jurisdiction",
        "role": "supports",
        "sourceId": "hirschl-constitutional-theocracy-source",
      },
    ],
    "id": "theocracy-religious-law-boundary",
    "statementKind": "editorial-interpretation",
    "text": "A clause naming religious law as a source or limit of legislation is evidence of legal authority, but theocratic classification also depends on who interprets the clause and what consequences follow.",
  },
  {
    "citations": [
      {
        "locator": "p. 2, institutional forms",
        "role": "qualifies",
        "sourceId": "huzakai-theocracy-source",
      },
    ],
    "id": "theocracy-influence-boundary",
    "statementKind": "editorial-interpretation",
    "text": "Voting, lobbying, moral advocacy, or public religious language can influence government without assigning state authority to a religious office or religious-law reviewer.",
  },
  {
    "citations": [
      {
        "locator": "pp. 1–2, divine rule and human institutions",
        "role": "qualifies",
        "sourceId": "huzakai-theocracy-source",
      },
    ],
    "id": "theocracy-sacred-monarchy-boundary",
    "statementKind": "editorial-interpretation",
    "text": "A monarch's sacred status or claim of divine legitimation does not show whether religious officeholders or religious-law institutions govern.",
  },
  {
    "citations": [
      {
        "locator": "pp. 7–12, hybrid constitutional form",
        "role": "supports",
        "sourceId": "hirschl-constitutional-theocracy-source",
      },
    ],
    "id": "theocracy-authoritarianism-boundary",
    "statementKind": "editorial-interpretation",
    "text": "Theocracy concerns the institutional location or asserted source of governing authority; authoritarianism concerns constrained pluralism and limited political accountability, so neither classification follows automatically from the other.",
  },
  {
    "citations": [
      {
        "locator": "p. 1, conceptual history",
        "role": "context",
        "sourceId": "huzakai-theocracy-source",
      },
    ],
    "id": "theocracy-polemical-label-boundary",
    "statementKind": "editorial-interpretation",
    "text": "Calling opponents theocratic does not establish their formal offices, legal review powers, rules-in-use, or coercive capacities.",
  },
  {
    "citations": [
      {
        "locator": "pp. 2–12, definition and four elements",
        "role": "supports",
        "sourceId": "hirschl-constitutional-theocracy-source",
      },
    ],
    "id": "constitutional-theocracy-hybrid",
    "statementKind": "classification",
    "text": "Hirschl uses constitutional theocracy for systems that retain constitutional institutions while granting a single religion or its law formal status and empowering religious bodies or courts in constitutional governance.",
  },
  {
    "citations": [
      {
        "locator": "article 2",
        "role": "supports",
        "sourceId": "iran-constitution-1989-source",
      },
    ],
    "id": "iran-divine-sovereignty-principles",
    "statementKind": "observation",
    "text": "Article 2 grounds the Islamic Republic in belief in one God, divine sovereignty and legislation, revelation, and leadership, while also naming human dignity, reason, science, and public participation.",
  },
  {
    "citations": [
      {
        "locator": "article 4",
        "role": "supports",
        "sourceId": "iran-constitution-1989-source",
      },
    ],
    "id": "iran-laws-islamic-criteria",
    "statementKind": "observation",
    "text": "Article 4 requires civil, criminal, financial, economic, administrative, cultural, military, political, and other laws and regulations to conform to Islamic criteria, with Guardian Council jurists judging conformity.",
  },
  {
    "citations": [
      {
        "locator": "article 6",
        "role": "supports",
        "sourceId": "iran-constitution-1989-source",
      },
    ],
    "id": "iran-popular-elections",
    "statementKind": "observation",
    "text": "Article 6 states that public affairs are administered through elections and referenda, including elections for the presidency, parliament, and councils.",
  },
  {
    "citations": [
      {
        "locator": "article 57",
        "role": "supports",
        "sourceId": "iran-constitution-1989-source",
      },
    ],
    "id": "iran-separation-under-leader",
    "statementKind": "observation",
    "text": "Article 57 assigns legislative, executive, and judicial powers to separate branches while placing them under the supervision of the absolute religious Leader.",
  },
  {
    "citations": [
      {
        "locator": "articles 91–92",
        "role": "supports",
        "sourceId": "iran-constitution-1989-source",
      },
    ],
    "id": "iran-guardian-council-composition",
    "statementKind": "observation",
    "text": "Articles 91 and 92 establish twelve Guardian Council members: six Islamic jurists selected by the Leader and six lawyers elected by parliament from nominees of the judiciary chief.",
  },
  {
    "citations": [
      {
        "locator": "articles 93–96",
        "role": "supports",
        "sourceId": "iran-constitution-1989-source",
      },
    ],
    "id": "iran-guardian-council-review",
    "statementKind": "observation",
    "text": "Articles 93 through 96 make the Guardian Council necessary to ordinary parliamentary validity and assign it review of legislation for Islamic and constitutional conformity.",
  },
  {
    "citations": [
      {
        "locator": "article 99",
        "role": "supports",
        "sourceId": "iran-constitution-1989-source",
      },
    ],
    "id": "iran-guardian-council-elections",
    "statementKind": "observation",
    "text": "Article 99 assigns the Guardian Council supervision of elections for the Assembly of Experts, presidency, parliament, and referenda.",
  },
  {
    "citations": [
      {
        "locator": "articles 107 and 111",
        "role": "supports",
        "sourceId": "iran-constitution-1989-source",
      },
    ],
    "id": "iran-leader-selection",
    "statementKind": "observation",
    "text": "Articles 107 and 111 assign the elected Assembly of Experts authority to designate and, under specified conditions, dismiss the Leader.",
  },
  {
    "citations": [
      {
        "locator": "article 110",
        "role": "supports",
        "sourceId": "iran-constitution-1989-source",
      },
    ],
    "id": "iran-leader-powers",
    "statementKind": "observation",
    "text": "Article 110 assigns the Leader powers including setting general policies, commanding the armed forces, declaring war and peace, making senior appointments, and confirming or dismissing the president under specified rules.",
  },
  {
    "citations": [
      {
        "locator": "article 112",
        "role": "supports",
        "sourceId": "iran-constitution-1989-source",
      },
    ],
    "id": "iran-expediency-council",
    "statementKind": "observation",
    "text": "Article 112 provides for an Expediency Council appointed by the Leader to address specified disputes between parliament and the Guardian Council and advise the Leader.",
  },
  {
    "citations": [
      {
        "locator": "pp. 1–12 and 293–310",
        "role": "supports",
        "sourceId": "schirazi-constitution-iran-source",
      },
      {
        "locator": "sections on sovereignty, institutions, and contradictions",
        "role": "supports",
        "sourceId": "iranica-iran-constitution-source",
      },
    ],
    "id": "iran-hybrid-rival-reading",
    "statementKind": "classification",
    "text": "Schirazi argues that Iran's constitutional order joins popular-sovereignty institutions to clerical supervisory authority and documents persistent conflict rather than a single undifferentiated clerical chain of command.",
  },
  {
    "citations": [
      {
        "locator": "pp. 33–48, Iran",
        "role": "supports",
        "sourceId": "hirschl-constitutional-theocracy-source",
      },
      {
        "locator": "articles 4, 6, 57, 91–99, and 107–112",
        "role": "supports",
        "sourceId": "iran-constitution-1989-source",
      },
    ],
    "id": "iran-classification-qualified",
    "statementKind": "editorial-interpretation",
    "text": "The amended 1989 constitutional design combines elected offices and separate branches with binding Islamic-law review and extensive powers assigned to religiously qualified institutions; this placement describes those institutions, not Islam or Shi'a traditions.",
  },
  {
    "citations": [
      {
        "locator": "article 1",
        "role": "supports",
        "sourceId": "vatican-fundamental-law-2023-source",
      },
    ],
    "id": "vatican-pope-sovereign",
    "statementKind": "observation",
    "text": "Article 1 of the 2023 Fundamental Law states that the Supreme Pontiff, sovereign of Vatican City State, possesses the fullness of governmental power, including legislative, executive, and judicial power.",
  },
  {
    "citations": [
      {
        "locator": "articles 7–8",
        "role": "supports",
        "sourceId": "vatican-fundamental-law-2023-source",
      },
    ],
    "id": "vatican-legislative-commission",
    "statementKind": "observation",
    "text": "Articles 7 and 8 provide that the Pontifical Commission exercises legislative power except in matters reserved to the Pope and is composed of cardinals and other members appointed for five-year terms.",
  },
  {
    "citations": [
      {
        "locator": "articles 10–13",
        "role": "supports",
        "sourceId": "vatican-fundamental-law-2023-source",
      },
    ],
    "id": "vatican-executive-governorate",
    "statementKind": "observation",
    "text": "Articles 10 through 13 assign executive functions to the President of the Governorate under the law's specified structure and reporting duties.",
  },
  {
    "citations": [
      {
        "locator": "article 21",
        "role": "supports",
        "sourceId": "vatican-fundamental-law-2023-source",
      },
      {
        "locator": "articles 1–2",
        "role": "context",
        "sourceId": "vatican-judicial-law-2020-source",
      },
    ],
    "id": "vatican-judicial-name",
    "statementKind": "observation",
    "text": "Article 21 provides that judicial power is exercised in the name of the Supreme Pontiff by organs constituted under Vatican judicial law.",
  },
  {
    "citations": [
      {
        "locator": "sections ‘The Holy See’ and ‘Vatican City State’",
        "role": "supports",
        "sourceId": "holy-see-vatican-distinction-source",
      },
      {
        "locator": "section on origins and nature; Lateran Treaty context",
        "role": "context",
        "sourceId": "lateran-treaty-source",
      },
    ],
    "id": "holy-see-vatican-distinct",
    "statementKind": "observation",
    "text": "The Holy See's institutional account distinguishes the sovereign subject of international law centered on the Pope and Roman Curia from Vatican City State, the territorial state created to secure that independence.",
  },
  {
    "citations": [
      {
        "locator": "canon 331",
        "role": "supports",
        "sourceId": "canon-law-331-source",
      },
      {
        "locator": "article 1",
        "role": "supports",
        "sourceId": "vatican-fundamental-law-2023-source",
      },
    ],
    "id": "pope-religious-state-office",
    "statementKind": "editorial-interpretation",
    "text": "Canon 331 describes the Roman Pontiff's supreme ecclesial office, while Vatican Fundamental Law separately identifies the same officeholder as sovereign of the state; the two jurisdictions should not be collapsed.",
  },
  {
    "citations": [
      {
        "locator": "articles 1 and 7–21",
        "role": "supports",
        "sourceId": "vatican-fundamental-law-2023-source",
      },
      {
        "locator": "sections on legislative and executive implementation",
        "role": "context",
        "sourceId": "vatican-law-one-year-source",
      },
    ],
    "id": "vatican-delegation-boundary",
    "statementKind": "editorial-interpretation",
    "text": "The 2023 Fundamental Law delegates ordinary legislative and executive functions to state organs while reserving the Pope's plenitude of governmental power and allowing him to reserve matters.",
  },
  {
    "citations": [
      {
        "locator": "articles 1 and 7–21",
        "role": "supports",
        "sourceId": "vatican-fundamental-law-2023-source",
      },
    ],
    "id": "vatican-classification-qualified",
    "statementKind": "editorial-interpretation",
    "text": "Vatican City's 2023 constitutional design places ultimate legislative, executive, and judicial authority in the Pope, whose eligibility derives from a religious office, while ordinary functions are delegated to distinct state organs; the placement does not classify Catholic people or Christianity.",
  },
]
`;

