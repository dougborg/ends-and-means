  "statements": [
    {
      "description": "Liberalism contains competing traditions",
      "id": "liberalism-plural-traditions",
      "kind": "statement",
      "label": "Liberalism contains competing traditions",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "definition",
      "text": "Liberalism names related but competing traditions rather than one fixed doctrine or policy package.",
    },
    {
      "description": "Liberal authority requires justification",
      "id": "liberalism-authority-justification",
      "kind": "statement",
      "label": "Liberal authority requires justification",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "attributed-value",
      "text": "Gaus, Courtland, and Schmidtz describe the demand that political authority be justified as a starting point shared across liberal traditions.",
    },
    {
      "description": "Liberals dispute the meaning of liberty",
      "id": "liberalism-liberty-disputes",
      "kind": "statement",
      "label": "Liberals dispute the meaning of liberty",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "definition",
      "text": "Liberal traditions disagree over negative, positive, and republican interpretations of liberty.",
    },
    {
      "description": "Old and new liberalisms differ",
      "id": "liberalism-old-new-boundary",
      "kind": "statement",
      "label": "Old and new liberalisms differ",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "definition",
      "text": "The Stanford Encyclopedia distinguishes classical or old liberalism from new liberal traditions that give a larger role to social justice and public action.",
    },
    {
      "description": "A liberal label does not specify institutions",
      "id": "liberalism-label-insufficient",
      "kind": "statement",
      "label": "A liberal label does not specify institutions",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "Calling a constitution, party, market, or welfare program liberal does not identify which liberal justification or institutional commitments it adopts.",
    },
    {
      "description": "Mill limited coercion by harm to others",
      "id": "mill-liberty-limiting-principle",
      "kind": "statement",
      "label": "Mill limited coercion by harm to others",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "attributed-value",
      "text": "Mill argued that preventing harm to others, rather than a person's own good, can justify coercive power over an adult member of a civilized community.",
    },
    {
      "description": "Mill excluded peoples he called barbarians",
      "id": "mill-colonial-exclusion",
      "kind": "statement",
      "label": "Mill excluded peoples he called barbarians",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "observation",
      "text": "Mill stated that his liberty principle did not apply to peoples he classified as barbarians and allowed despotism as a means of their improvement.",
    },
    {
      "description": "Mehta examines liberal arguments for empire",
      "id": "mehta-liberal-empire-tension",
      "kind": "statement",
      "label": "Mehta examines liberal arguments for empire",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "classification",
      "text": "Mehta argues that nineteenth-century British liberals made imperial rule intelligible by placing colonized peoples within a staged account of human development.",
    },
    {
      "description": "Pateman challenges gender-neutral contract",
      "id": "pateman-contract-gender-boundary",
      "kind": "statement",
      "label": "Pateman challenges gender-neutral contract",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "classification",
      "text": "Pateman argues that canonical contract theories hide a gendered settlement in which civil freedom for men depends on women's subordination.",
    },
    {
      "description": "India's Constitution specifies equality before law",
      "id": "india-equality-before-law",
      "kind": "statement",
      "label": "India's Constitution specifies equality before law",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "observation",
      "text": "Article 14 of India's Constitution guarantees equality before the law and equal protection of the laws within India.",
    },
    {
      "description": "India's Constitution lists prohibited discrimination grounds",
      "id": "india-discrimination-grounds",
      "kind": "statement",
      "label": "India's Constitution lists prohibited discrimination grounds",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "observation",
      "text": "Article 15(1) prohibits the state from discriminating against a citizen only on grounds of religion, race, caste, sex, or place of birth.",
    },
    {
      "description": "India's original Constitution permitted special provisions for women and children",
      "id": "india-special-provisions",
      "kind": "statement",
      "label": "India's original Constitution permitted special provisions for women and children",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "observation",
      "text": "Article 15(3) of India's Constitution permits the state to make special provisions for women and children.",
    },
    {
      "description": "Japan's Constitution specifies legal equality",
      "id": "japan-legal-equality",
      "kind": "statement",
      "label": "Japan's Constitution specifies legal equality",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "observation",
      "text": "Article 14 of Japan's Constitution states that all people are equal under the law and prohibits discrimination in political, economic, or social relations on its listed grounds.",
    },
    {
      "description": "Japan's Constitution requires mutual consent for marriage",
      "id": "japan-marriage-consent",
      "kind": "statement",
      "label": "Japan's Constitution requires mutual consent for marriage",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "observation",
      "text": "Article 24 of Japan's Constitution states that marriage is based only on the mutual consent of both sexes.",
    },
    {
      "description": "Japan's Constitution specifies equal spousal rights",
      "id": "japan-spousal-equality",
      "kind": "statement",
      "label": "Japan's Constitution specifies equal spousal rights",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "observation",
      "text": "Article 24 states that marriage is maintained through mutual cooperation with equal rights of husband and wife as a basis.",
    },
    {
      "description": "Japan's rights settlement had an occupation-era drafting context",
      "id": "japan-rights-drafting-boundary",
