exports[`foundational Environmentalism guide > pins Statements, citation roles, and locators 1`] = `
[
  {
    "citations": [
      {
        "locator": "introduction; sections 1 and 4",
        "role": "supports",
        "sourceId": "sep-environmental-ethics-source",
      },
    ],
    "id": "environmentalism-contested-family",
    "statementKind": "definition",
    "text": "Environmentalism names multiple ethical positions, movements, and political projects rather than one doctrine, organization, or policy program.",
  },
  {
    "citations": [
      {
        "locator": "introduction, paragraphs 1–5; section 5",
        "role": "supports",
        "sourceId": "sep-environmental-ethics-source",
      },
    ],
    "id": "environmentalism-science-boundary",
    "statementKind": "editorial-interpretation",
    "text": "Ecology and environmental science investigate relationships and conditions, while environmentalism makes ethical or political claims about what people and institutions should do.",
  },
  {
    "citations": [
      {
        "locator": "publisher description, paragraphs 1–2",
        "role": "supports",
        "sourceId": "guha-environmentalism-global-history-source",
      },
    ],
    "id": "environmentalism-conservation-boundary",
    "statementKind": "editorial-interpretation",
    "text": "Conservation and preservation are historically important but disputed projects within a wider field that also addresses pollution, health, livelihood, justice, technology, and political authority.",
  },
  {
    "citations": [
      {
        "locator": "chapter 2, paragraphs 1–27",
        "role": "supports",
        "sourceId": "brundtland-common-future-source",
      },
    ],
    "id": "environmentalism-sustainability-boundary",
    "statementKind": "definition",
    "text": "The Brundtland Commission defined sustainable development around meeting present needs without compromising future generations, a formulation that neither defines all environmentalism nor resolves disputes over needs and distribution.",
  },
  {
    "citations": [
      {
        "locator": "sections 4.6 and 5",
        "role": "context",
        "sourceId": "sep-environmental-ethics-source",
      },
    ],
    "id": "environmentalism-climate-boundary",
    "statementKind": "editorial-interpretation",
    "text": "Climate mitigation and adaptation are policy fields that may be supported, opposed, or interpreted differently within environmental movements, while environmentalism also concerns harms and relations not reducible to climate change.",
  },
  {
    "citations": [
      {
        "locator": "sections 1–5",
        "role": "context",
        "sourceId": "sep-environmental-ethics-source",
      },
    ],
    "id": "environmentalism-party-policy-boundary",
    "statementKind": "editorial-interpretation",
    "text": "A green party, environmental agency, protected area, pollution rule, or energy policy requires its own actors, design, operation, and outcomes; its label alone does not establish environmentalist purposes or effects.",
  },
  {
    "citations": [
      {
        "locator": "publisher description, paragraphs 1–2",
        "role": "supports",
        "sourceId": "guha-environmentalism-global-history-source",
      },
    ],
    "id": "environmentalism-global-history-plural",
    "statementKind": "classification",
    "text": "Guha distinguishes multiple histories and social bases of environmental action rather than treating environmentalism as a single movement exported unchanged from one region.",
  },
  {
    "citations": [
      {
        "locator": "introduction, pp. 1–15",
        "role": "supports",
        "sourceId": "martinez-alier-environmentalism-poor-source",
      },
    ],
    "id": "environmentalism-poor-attributed-classification",
    "statementKind": "classification",
    "text": "Martínez-Alier uses environmentalism of the poor for conflicts in which livelihood and unequal exposure motivate resistance to environmental damage; the category is an attributed interpretation, not a self-description inherited by every affected community.",
  },
  {
    "citations": [
      {
        "locator": "abstract; pp. 397–401 and 405–413",
        "role": "supports",
        "sourceId": "schlosberg-environmental-justice-source",
      },
    ],
    "id": "environmental-justice-three-dimensions",
    "statementKind": "definition",
    "text": "Schlosberg distinguishes distribution, participation or procedure, and recognition as related dimensions of environmental justice rather than one interchangeable measure.",
  },
  {
    "citations": [
      {
        "locator": "pp. 599–604 and 611–614",
        "role": "supports",
        "sourceId": "whyte-indigenous-climate-source",
      },
    ],
    "id": "indigenous-relations-boundary",
    "statementKind": "editorial-interpretation",
    "text": "Whyte argues that Indigenous climate vulnerability and collective action must be understood through histories of colonialism, governance, and reciprocal responsibilities rather than treating Indigenous knowledge as a detachable policy input.",
  },
  {
    "citations": [
      {
        "locator": "chapters 2–4, pp. 35–116",
        "role": "supports",
        "sourceId": "guha-unquiet-woods-source",
      },
    ],
    "id": "colonial-conservation-displacement",
    "statementKind": "editorial-interpretation",
    "text": "Protected-land and forestry projects can restrict customary access and political authority, so conservation status alone cannot establish justice or environmental benefit for affected communities.",
  },
  {
    "citations": [
      {
        "locator": "sections 4.4–4.6 and 5",
        "role": "context",
        "sourceId": "sep-environmental-ethics-source",
      },
    ],
    "id": "nuclear-environmental-policy-boundary",
    "statementKind": "editorial-interpretation",
    "text": "Nuclear power and nuclear weapons raise distinct questions about climate, extraction, land, safety, waste, security, and justice; an environmentalist relationship does not determine a position on either technology.",
  },
  {
    "citations": [
      {
        "locator": "chapters 3–5, pp. 61–152",
        "role": "supports",
        "sourceId": "guha-unquiet-woods-source",
      },
    ],
    "id": "chipko-commercial-forestry-conflict",
    "statementKind": "observation",
    "text": "Guha locates Chipko actions in Garhwal conflicts over state forestry, commercial felling, local access, and village livelihood during the 1970s.",
  },
  {
    "citations": [
      {
        "locator": "chapter 5, pp. 130–152",
        "role": "supports",
        "sourceId": "guha-unquiet-woods-source",
      },
    ],
    "id": "chipko-organized-tree-protection",
    "statementKind": "observation",
    "text": "Participants in selected Garhwal actions used collective presence and nonviolent obstruction to prevent contracted tree felling.",
  },
  {
    "citations": [
      {
        "locator": "pp. 119–125 and 145–154",
        "role": "supports",
        "sourceId": "agarwal-gender-environment-debate-source",
      },
    ],
    "id": "chipko-women-participation",
    "statementKind": "observation",
    "text": "Agarwal relates rural women's participation in forest protection to gendered divisions of labor, subsistence responsibilities, property, and decision-making power rather than an innate female closeness to nature.",
  },
  {
    "citations": [
      {
        "locator": "pp. 119–126 and 145–154",
        "role": "supports",
        "sourceId": "agarwal-gender-environment-debate-source",
      },
    ],
    "id": "chipko-ecofeminist-rival",
    "statementKind": "causal-hypothesis",
    "text": "Agarwal challenges accounts that explain Chipko through a universal women–nature bond and instead emphasizes material and institutional differences among women.",
  },
  {
    "citations": [
      {
        "locator": "abstract; pp. 343–362",
        "role": "supports",
        "sourceId": "rangan-contested-boundaries-source",
      },
    ],
    "id": "chipko-state-community-rival",
    "statementKind": "causal-hypothesis",
    "text": "Rangan argues that Garhwal forestry involved negotiation and conflict among state institutions, communities, and classes rather than a simple state-versus-community divide.",
  },
  {
    "citations": [
      {
        "locator": "contents; section II(A), Subject Files 3–5; section II(B)",
        "role": "supports",
        "sourceId": "chandi-prasad-bhatt-papers-catalogue-source",
      },
    ],
    "id": "chipko-local-archive-provenance",
    "statementKind": "observation",
    "text": "The Chandi Prasad Bhatt papers catalogue identifies Hindi correspondence and organizational files from the Dasholi Gram Swarajya Mandal and Chipko activity in Chamoli, including 1973 forest-preservation records and Reni material.",
  },
  {
    "citations": [
      {
        "locator": "abstract; pp. 343–362",
        "role": "qualifies",
        "sourceId": "rangan-contested-boundaries-source",
      },
    ],
    "id": "chipko-case-boundary",
    "statementKind": "editorial-interpretation",
    "text": "The selected Garhwal actions illuminate forestry, livelihood, gender, and movement interpretation but do not define all Chipko activity, Indian environmentalism, or rural women's politics.",
  },
  {
    "citations": [
      {
        "locator": "pp. 1–4 and appendix I",
        "role": "supports",
        "sourceId": "gao-hazardous-landfills-source",
      },
    ],
    "id": "warren-county-landfill-siting",
    "statementKind": "observation",
    "text": "North Carolina selected a predominantly Black Warren County community for a landfill holding soil contaminated by illegal PCB dumping elsewhere in the state.",
  },
  {
    "citations": [
      {
        "locator": "foreword, pp. x–xiii; pp. 17–20",
        "role": "supports",
        "sourceId": "ucc-toxic-wastes-race-source",
      },
    ],
    "id": "warren-county-protest",
    "statementKind": "observation",
    "text": "In 1982, Warren County residents and allied civil-rights and religious organizations used demonstrations and civil disobedience against the landfill, and hundreds of participants were arrested.",
  },
  {
    "citations": [
      {
        "locator": "pp. 1–4 and appendix I",
        "role": "supports",
        "sourceId": "gao-hazardous-landfills-source",
      },
    ],
    "id": "warren-county-landfill-built",
    "statementKind": "observation",
    "text": "The protests did not prevent construction and filling of the Warren County PCB landfill.",
  },
  {
    "citations": [
      {
        "locator": "digest; pp. 1–4 and 14–16",
        "role": "supports",
        "sourceId": "gao-hazardous-landfills-source",
      },
    ],
    "id": "gao-siting-pattern",
    "statementKind": "observation",
    "text": "The 1983 General Accounting Office study found that three of four southeastern hazardous-waste landfills it examined were in majority-Black communities and that all four surrounding communities had relatively high poverty rates.",
  },
  {
    "citations": [
      {
        "locator": "executive summary, pp. xiii–xvi; pp. 13–16",
        "role": "supports",
        "sourceId": "ucc-toxic-wastes-race-source",
      },
    ],
    "id": "ucc-national-race-finding",
    "statementKind": "observation",
    "text": "The 1987 United Church of Christ study reported race as the most significant variable associated with commercial hazardous-waste facility location in its national analysis.",
  },
  {
    "citations": [
      {
        "locator": "Principles 1–17",
        "role": "supports",
        "sourceId": "ej-principles-source",
      },
    ],
    "id": "ej-summit-principles",
    "statementKind": "attributed-value",
    "text": "Delegates at the First National People of Color Environmental Leadership Summit adopted seventeen principles linking ecological protection with self-determination, public participation, health, work, and opposition to environmental racism.",
  },
  {
    "citations": [
      {
        "locator": "pp. 397–405",
        "role": "qualifies",
        "sourceId": "schlosberg-environmental-justice-source",
      },
    ],
    "id": "warren-county-causal-boundary",
    "statementKind": "editorial-interpretation",
    "text": "Warren County became an important reference point for environmental-justice organizing, but the selected evidence does not isolate its effect from longer civil-rights, labor, Indigenous, and anti-toxics organizing or prove that it caused every later policy change.",
  },
  {
    "citations": [
      {
        "locator": "sections 12 and 14–16",
        "role": "supports",
        "sourceId": "te-awa-tupua-act-source",
      },
    ],
    "id": "te-awa-legal-person",
    "statementKind": "observation",
    "text": "The Te Awa Tupua Act declares Te Awa Tupua a legal person with corresponding rights, powers, duties, and liabilities.",
  },
  {
    "citations": [
      {
        "locator": "sections 12–13",
        "role": "supports",
        "sourceId": "te-awa-tupua-act-source",
      },
    ],
    "id": "te-awa-living-whole",
    "statementKind": "observation",
    "text": "The Act recognizes Te Awa Tupua as an indivisible living whole from the mountains to the sea, incorporating physical and metaphysical elements.",
  },
  {
    "citations": [
      {
        "locator": "section 13 and sections 29–37",
        "role": "supports",
        "sourceId": "te-awa-tupua-act-source",
      },
    ],
    "id": "te-awa-tupua-kawa",
    "statementKind": "observation",
    "text": "The Act sets out Tupua te Kawa as intrinsic values and requires relevant actors to recognize the relationship of Whanganui iwi and hapū with Te Awa Tupua.",
  },
  {
    "citations": [
      {
        "locator": "sections 18–23",
        "role": "supports",
        "sourceId": "te-awa-tupua-act-source",
      },
    ],
    "id": "te-pou-tupua-representation",
    "statementKind": "observation",
    "text": "The Act establishes Te Pou Tupua as the human face of Te Awa Tupua and provides for two appointees acting as one office.",
  },
  {
    "citations": [
      {
        "locator": "Legal Recognition of Te Awa Tupua, paragraphs 1–10",
        "role": "supports",
        "sourceId": "te-pou-tupua-te-awa-source",
      },
    ],
    "id": "te-awa-iwi-provenance",
    "statementKind": "observation",
    "text": "Te Pou Tupua describes the framework as supporting values practised by Whanganui hapū and iwi and protecting their continuing authority to speak for their own interests.",
  },
  {
    "citations": [
      {
        "locator": "Legal Recognition of Te Awa Tupua, paragraphs 1–10; community account, paragraphs 1–8",
        "role": "supports",
        "sourceId": "te-pou-tupua-te-awa-source",
      },
      {
        "locator": "long title; sections 3, 12–20, and 69–71",
        "role": "supports",
        "sourceId": "te-awa-tupua-act-source",
      },
    ],
    "id": "te-awa-environmentalism-boundary",
    "statementKind": "editorial-interpretation",
    "text": "The Te Awa Tupua framework is a Whanganui iwi–Crown settlement and legal-governance arrangement grounded in Whanganui relationships and law; placing it near environmentalism does not reclassify those relationships as an environmental ideology.",
  },
]
`;

