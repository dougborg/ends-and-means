exports[`foundational Oligarchy guide > pins every Statement, citation role, and locator in the evidence ledger 1`] = `
[
  {
    "citations": [
      {
        "locator": "Book III, chapter 7, 1279a22–1279b10",
        "role": "supports",
        "sourceId": "aristotle-politics-rackham-source",
      },
    ],
    "id": "oligarchy-aristotle-few-common-interest",
    "statementKind": "definition",
    "text": "In Rackham's translation of Aristotle's constitutional scheme, government by a few for the common interest is aristocracy, while its deviation for the rulers' advantage is oligarchy.",
  },
  {
    "citations": [
      {
        "locator": "Book III, chapter 8, 1279b11–1280a6",
        "role": "supports",
        "sourceId": "aristotle-politics-rackham-source",
      },
    ],
    "id": "oligarchy-aristotle-wealth-distinction",
    "statementKind": "definition",
    "text": "Aristotle argues that poverty and wealth distinguish democracy from oligarchy more exactly than the bare fact that many or few govern.",
  },
  {
    "citations": [
      {
        "locator": "book abstract and chapter 1 abstract",
        "role": "supports",
        "sourceId": "simonton-classical-greek-oligarchy-source",
      },
    ],
    "id": "oligarchy-simonton-historical-form",
    "statementKind": "definition",
    "text": "Simonton describes classical Greek oligarchy as minority rule by wealthy citizens maintained through institutions that coordinated rulers and divided opponents.",
  },
  {
    "citations": [
      {
        "locator": "abstract, paragraphs 1–2",
        "role": "supports",
        "sourceId": "winters-oligarchy-encyclopedia-source",
      },
    ],
    "id": "oligarchy-winters-wealth-defense",
    "statementKind": "definition",
    "text": "Winters defines oligarchs as actors who command concentrated material resources and directs oligarchy theory toward their wealth-defense objectives.",
  },
  {
    "citations": [
      {
        "locator": "pp. 731–733",
        "role": "supports",
        "sourceId": "page-winters-us-oligarchy-source",
      },
    ],
    "id": "oligarchy-page-winters-democracy-coexistence",
    "statementKind": "definition",
    "text": "Page and Winters argue that democratic institutions can coexist with oligarchic power because wealthy actors need not hold office or control every political question.",
  },
  {
    "citations": [
      {
        "locator": "pp. 731–735",
        "role": "supports",
        "sourceId": "page-winters-us-oligarchy-source",
      },
    ],
    "id": "oligarchy-elite-theory-distinction",
    "statementKind": "definition",
    "text": "Page and Winters distinguish their material account of oligarchy from elite theories concerned more broadly with leadership, organization, expertise, or control by minorities.",
  },
  {
    "citations": [
      {
        "locator": "chapter 1 abstract and book abstract",
        "role": "context",
        "sourceId": "simonton-classical-greek-oligarchy-source",
      },
    ],
    "id": "oligarchy-polemic-boundary",
    "statementKind": "editorial-interpretation",
    "text": "Calling opponents an oligarchy identifies a political allegation, not evidence that a named definition, mechanism, and bounded outcome have been established.",
  },
  {
    "citations": [
      {
        "locator": "pp. 1–9",
        "role": "supports",
        "sourceId": "ford-pepinsky-beyond-oligarchy-introduction-source",
      },
    ],
    "id": "oligarchy-inequality-boundary",
    "statementKind": "editorial-interpretation",
    "text": "A distribution of wealth can identify unequal resources without establishing who used them, through which mechanism, to affect which political outcome.",
  },
  {
    "citations": [
      {
        "locator": "pp. 731–736",
        "role": "supports",
        "sourceId": "page-winters-us-oligarchy-source",
      },
    ],
    "id": "oligarchy-officeholding-boundary",
    "statementKind": "editorial-interpretation",
    "text": "Formal office, agenda control, ownership, coercion, organization, and informal access are different mechanisms and should not be inferred from one another.",
  },
  {
    "citations": [
      {
        "locator": "pp. 564–565 and 573–577",
        "role": "supports",
        "sourceId": "gilens-page-testing-theories-source",
      },
    ],
    "id": "oligarchy-regime-boundary",
    "statementKind": "editorial-interpretation",
    "text": "Evidence about one institution, policy domain, period, or model cannot by itself classify an entire political order as oligarchic.",
  },
  {
    "citations": [
      {
        "locator": "chapters 29.1–29.4",
        "role": "supports",
        "sourceId": "aristotle-athenian-constitution-rackham-source",
      },
    ],
    "id": "athens-411-war-crisis",
    "statementKind": "observation",
    "text": "The Athenian Constitution places the constitutional change after the Sicilian disaster and amid expectations of Persian assistance in the war.",
  },
  {
    "citations": [
      {
        "locator": "chapter 29.5",
        "role": "supports",
        "sourceId": "aristotle-athenian-constitution-rackham-source",
      },
    ],
    "id": "athens-411-five-thousand-proposal",
    "statementKind": "observation",
    "text": "The proposed constitution entrusted government to at least five thousand Athenians judged most able to serve with person and property.",
  },
  {
    "citations": [
      {
        "locator": "chapter 32.1",
        "role": "supports",
        "sourceId": "aristotle-athenian-constitution-rackham-source",
      },
    ],
    "id": "athens-411-four-hundred-actual-rule",
    "statementKind": "observation",
    "text": "The Athenian Constitution reports that the Five Thousand were initially only nominally selected while the Four Hundred occupied the council house and administered government.",
  },
  {
    "citations": [
      {
        "locator": "Book VIII, chapters 65–66",
        "role": "supports",
        "sourceId": "thucydides-peloponnesian-war-crawley-source",
      },
    ],
    "id": "athens-411-coercion",
    "statementKind": "observation",
    "text": "Thucydides reports that conspirators used assassinations and fear while the identities and numbers behind the movement remained uncertain to other citizens.",
  },
  {
    "citations": [
      {
        "locator": "chapter 33.1",
        "role": "supports",
        "sourceId": "aristotle-athenian-constitution-rackham-source",
      },
    ],
    "id": "athens-411-four-hundred-duration",
    "statementKind": "observation",
    "text": "The Athenian Constitution dates the rule of the Four Hundred to approximately four months in 411 BCE.",
  },
  {
    "citations": [
      {
        "locator": "Book VIII, chapter 97.1–2",
        "role": "supports",
        "sourceId": "thucydides-peloponnesian-war-crawley-source",
      },
    ],
    "id": "athens-411-five-thousand-successor",
    "statementKind": "observation",
    "text": "Thucydides reports that the Athenians deposed the Four Hundred and transferred affairs to the Five Thousand, defined as those able to furnish their own arms.",
  },
  {
    "citations": [
      {
        "locator": "chapter 1 abstract",
        "role": "context",
        "sourceId": "simonton-classical-greek-oligarchy-source",
      },
    ],
    "id": "athens-411-source-boundary",
    "statementKind": "editorial-interpretation",
    "text": "The surviving narrative accounts describe institutions and actions in 411 BCE but do not supply a neutral census of participation or make later oligarchy theories interchangeable with ancient oligarchia.",
  },
  {
    "citations": [
      {
        "locator": "pp. 11–15",
        "role": "supports",
        "sourceId": "winters-indonesia-oligarchy-democracy-source",
      },
    ],
    "id": "indonesia-winters-material-power",
    "statementKind": "causal-hypothesis",
    "text": "Winters argues that highly concentrated material resources gave wealthy actors unusually durable and versatile political power in post-1998 Indonesia.",
  },
  {
    "citations": [
      {
        "locator": "pp. 15–20",
        "role": "supports",
        "sourceId": "winters-indonesia-oligarchy-democracy-source",
      },
    ],
    "id": "indonesia-winters-wealth-defense",
    "statementKind": "causal-hypothesis",
    "text": "Winters interprets wealth defense as a central shared objective of Indonesian oligarchs across the transition from the New Order to electoral democracy.",
  },
  {
    "citations": [
      {
        "locator": "pp. 1–9",
        "role": "supports",
        "sourceId": "ford-pepinsky-beyond-oligarchy-introduction-source",
      },
    ],
    "id": "indonesia-democracy-coexistence",
    "statementKind": "observation",
    "text": "The Indonesia debate examines how electoral democracy after 1998 could coexist with continuing concentrations of material and organizational power.",
  },
  {
    "citations": [
      {
        "locator": "pp. 35–38 and 54–57",
        "role": "supports",
        "sourceId": "hadiz-robison-reorganization-power-source",
      },
    ],
    "id": "indonesia-hadiz-robison-rival",
    "statementKind": "causal-hypothesis",
    "text": "Hadiz and Robison explain post-New Order politics through the reorganization of entrenched interests and networks rather than a simple persistence of unchanged individual oligarchs.",
  },
  {
    "citations": [
      {
        "locator": "pp. 1–9",
        "role": "supports",
        "sourceId": "ford-pepinsky-beyond-oligarchy-introduction-source",
      },
    ],
    "id": "indonesia-beyond-oligarchy-critique",
    "statementKind": "causal-hypothesis",
    "text": "Ford and Pepinsky argue that an oligarchy framework can understate institutions, non-material resources, actors outside wealthy elites, and variation across Indonesian political contests.",
  },
  {
    "citations": [
      {
        "locator": "pp. 1–9",
        "role": "supports",
        "sourceId": "ford-pepinsky-beyond-oligarchy-introduction-source",
      },
    ],
    "id": "indonesia-debate-reply",
    "statementKind": "editorial-interpretation",
    "text": "Contributors to the Indonesia exchange dispute which resources, organizations, and institutions explain outcomes rather than treating wealth concentration alone as a complete result.",
  },
  {
    "citations": [
      {
        "locator": "title, pp. 11–13",
        "role": "context",
        "sourceId": "winters-indonesia-oligarchy-democracy-source",
      },
    ],
    "id": "indonesia-case-boundary",
    "statementKind": "editorial-interpretation",
    "text": "The 1998–2013 case records competing explanations of post-New Order power and does not assign Indonesia a timeless or regime-wide identity.",
  },
  {
    "citations": [
      {
        "locator": "pp. 564 and 568–570",
        "role": "supports",
        "sourceId": "gilens-page-testing-theories-source",
      },
    ],
    "id": "us-gilens-page-dataset",
    "statementKind": "observation",
    "text": "Gilens and Page analyzed 1,779 United States policy proposals from 1981 through 2002 for which preference and outcome data were available.",
  },
  {
    "citations": [
      {
        "locator": "pp. 572–575, tables 3–4",
        "role": "supports",
        "sourceId": "gilens-page-testing-theories-source",
      },
    ],
    "id": "us-gilens-page-elite-effect",
    "statementKind": "observation",
    "text": "In their 2014 publication, Gilens and Page reported that affluent Americans' preferences were strongly associated with outcomes in multivariate models of the 1981–2002 proposal sample after accounting for average-citizen preferences and interest-group alignments.",
  },
  {
    "citations": [
      {
        "locator": "pp. 572–575, tables 3–4",
        "role": "supports",
        "sourceId": "gilens-page-testing-theories-source",
      },
    ],
    "id": "us-gilens-page-average-effect",
    "statementKind": "observation",
    "text": "In the same 2014 models of the 1981–2002 proposal sample, average citizens' preferences had little or no independent association with policy outcomes when correlated preferences and organized groups were included.",
  },
  {
    "citations": [
      {
        "locator": "pp. 564–566 and 576–577",
        "role": "supports",
        "sourceId": "gilens-page-testing-theories-source",
      },
    ],
    "id": "us-gilens-page-not-oligarchy-test",
    "statementKind": "editorial-interpretation",
    "text": "Gilens and Page's 2014 article tested predictions associated with several theories of political influence using proposals dated 1981–2002; the dataset did not measure every political decision or establish a regime-wide classification.",
  },
  {
    "citations": [
      {
        "locator": "pp. 778–780 and 793–798",
        "role": "supports",
        "sourceId": "gilens-inequality-responsiveness-source",
      },
    ],
    "id": "us-gilens-earlier-income-gradient",
    "statementKind": "observation",
    "text": "Gilens's earlier analysis found that policy responsiveness increased with income, with the largest differences under conditions where preference gaps between income groups were wide.",
  },
  {
    "citations": [
      {
        "locator": "pp. 1–6",
        "role": "supports",
        "sourceId": "bashir-testing-inferences-source",
      },
    ],
    "id": "us-bashir-model-critique",
    "statementKind": "causal-hypothesis",
    "text": "In 2015, Bashir argued that correlated predictors, a dichotomous outcome, and model specification could generate an extreme contrast between affluent and average-citizen coefficients even under simulated equal influence.",
  },
  {
    "citations": [
      {
        "locator": "pp. 1–3",
        "role": "supports",
        "sourceId": "gilens-simulating-representation-source",
      },
    ],
    "id": "us-gilens-simulation-reply",
    "statementKind": "causal-hypothesis",
    "text": "In 2016, Gilens replied that Bashir's simulation imposed preference distributions and relationships unlike the observed data, so it did not reproduce the inferential problem it claimed to demonstrate.",
  },
  {
    "citations": [
      {
        "locator": "pp. 564–577",
        "role": "supports",
        "sourceId": "gilens-page-testing-theories-source",
      },
      {
        "locator": "pp. 1–6",
        "role": "qualifies",
        "sourceId": "bashir-testing-inferences-source",
      },
      {
        "locator": "pp. 1–3",
        "role": "qualifies",
        "sourceId": "gilens-simulating-representation-source",
      },
    ],
    "id": "us-study-bounded-conclusion",
    "statementKind": "editorial-interpretation",
    "text": "The study and its methodological exchange support scrutiny of unequal policy responsiveness within the sampled federal proposals, not a score or verdict for the United States as a whole.",
  },
]
`;

