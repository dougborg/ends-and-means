exports[`feminism evidence ledgers > pins every relationship, Case, Episode, Dossier, Guide, and Research Obligation > research-obligations 1`] = `
[
  {
    "addressedStatementIds": [
      "crenshaw-single-axis-limit",
      "mohanty-western-universal-limit",
      "moreton-robinson-indigenous-boundary",
    ],
    "currentLimitation": "The current evidence establishes three serious critiques but does not compare how exclusion operates across legal claims, transnational representation, Indigenous sovereignty, disability, citizenship, and caste.",
    "description": "A focused comparison of who universal claims exclude and through which institutions.",
    "evidenceNeeded": "Located self-descriptions and independent studies of specific organizations or policy disputes, including participants who contested their categories.",
    "id": "feminism-universal-subject-exclusion",
    "kind": "research-obligation",
    "label": "Exclusion by universal feminist subjects",
    "obligationStatus": "open",
    "obligationType": "counterargument",
    "publicationStatus": "reviewed",
    "question": "When feminist programs claim a common subject, whose interests, authority, or experience do their categories exclude?",
    "reviewedAt": "2026-09-06",
    "scope": "Selected organizations and texts in their named places and periods; no universal hierarchy of exclusions.",
    "statementIds": [],
    "target": {
      "id": "feminism",
      "kind": "concept",
    },
    "targetSectionId": "coalition-and-boundaries",
  },
  {
