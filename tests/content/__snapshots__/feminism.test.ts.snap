  },
  {
    "citations": [
      {
        "locator": "p. 17, Beginnings of the cooperative journey",
        "role": "supports",
        "sourceId": "ilo-sewa-cooperatives-source",
      },
    ],
    "id": "sewa-quilt-cooperative",
    "statementKind": "observation",
