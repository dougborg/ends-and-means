exports[`feminism evidence ledgers > pins every Statement, kind, source, role, and locator in the feminism ledger 1`] = `
[
  {
    "citations": [
      {
        "locator": "introduction, paragraphs 1–8; section 2, paragraphs 1–3",
        "role": "supports",
        "sourceId": "sep-feminist-political-philosophy-source",
      },
    ],
    "id": "feminism-contested-family",
    "statementKind": "definition",
    "text": "Feminism names multiple, sometimes conflicting analyses and political projects rather than one doctrine or institutional program.",
  },
  {
    "citations": [
      {
        "locator": "introduction, paragraphs 3–8",
        "role": "supports",
        "sourceId": "sep-feminist-political-philosophy-source",
      },
    ],
    "id": "feminism-analysis-action-distinction",
    "statementKind": "editorial-interpretation",
    "text": "Feminist political philosophy both analyzes gendered power and proposes changes to collective institutions, but an analysis does not by itself identify a movement, organization, or program.",
  },
  {
    "citations": [
      {
        "locator": "introduction, paragraphs 1–7; section 1, paragraphs 1–9",
        "role": "supports",
        "sourceId": "sep-feminist-political-philosophy-source",
      },
    ],
    "id": "feminism-public-private-boundary",
    "statementKind": "observation",
    "text": "Feminist political thinkers have treated family, workplaces, reproduction, and civil society as sites of power rather than presuming that only state government is political.",
  },
  {
    "citations": [
      {
        "locator": "sections 1–2.8, headings and introductory classifications",
        "role": "supports",
        "sourceId": "sep-feminist-political-philosophy-source",
      },
    ],
    "id": "feminism-traditions-nonexhaustive",
    "statementKind": "editorial-interpretation",
    "text": "The selected tradition labels are a non-exhaustive navigation aid and transmit no shared doctrine, political subject, or institutional program.",
  },
  {
    "citations": [
      {
        "locator": "section 2.1, paragraphs 1–18",
        "role": "supports",
        "sourceId": "sep-feminist-political-philosophy-source",
      },
    ],
    "id": "liberal-feminism-tradition",
    "statementKind": "observation",
    "text": "The Stanford Encyclopedia identifies liberal feminism as a current in feminist political thought organized around disputed accounts of personal and political autonomy.",
  },
  {
    "citations": [
      {
        "locator": "section 2.2, paragraphs 1–12",
        "role": "supports",
        "sourceId": "sep-feminist-political-philosophy-source",
      },
    ],
    "id": "radical-feminism-tradition",
    "statementKind": "observation",
    "text": "The Stanford Encyclopedia identifies radical feminism as a current that seeks structural change and disputes liberal emphasis on individual choice.",
  },
  {
    "citations": [
      {
        "locator": "section 2.3, paragraphs 1–18",
        "role": "supports",
        "sourceId": "sep-feminist-political-philosophy-source",
      },
    ],
    "id": "socialist-feminism-tradition",
    "statementKind": "observation",
    "text": "The Stanford Encyclopedia identifies socialist feminism as a current concerned with material conditions, class relations, labor, and social reproduction.",
  },
  {
    "citations": [
      {
        "locator": "section 2.3, paragraphs 1–18",
        "role": "supports",
        "sourceId": "sep-feminist-political-philosophy-source",
      },
    ],
    "id": "marxist-feminism-tradition",
    "statementKind": "observation",
    "text": "The Stanford Encyclopedia identifies Marxist feminism as a related but distinct current that analyzes gendered institutions through modes and relations of production and reproduction.",
  },
  {
    "citations": [
      {
        "locator": "section 2.1, paragraphs 1–18",
        "role": "supports",
        "sourceId": "sep-feminist-political-philosophy-source",
      },
    ],
    "id": "liberal-feminism-autonomy",
    "statementKind": "observation",
    "text": "Liberal feminist arguments commonly seek to protect and expand personal and political autonomy while also disputing liberal accounts of family, privacy, and dependency.",
  },
  {
    "citations": [
      {
        "locator": "section 2.2, paragraphs 1–12",
        "role": "supports",
        "sourceId": "sep-feminist-political-philosophy-source",
      },
    ],
    "id": "radical-feminism-structural-boundary",
    "statementKind": "observation",
    "text": "Radical feminist theories distinguish structural gender domination from unequal treatment that can be remedied only through individual choice or formal legal equality.",
  },
  {
    "citations": [
      {
        "locator": "section 2.3, paragraphs 1–18",
        "role": "supports",
        "sourceId": "sep-feminist-political-philosophy-source",
      },
    ],
    "id": "socialist-feminism-material-boundary",
    "statementKind": "observation",
    "text": "Socialist feminist work connects gender hierarchy to class, labor, household relations, and social reproduction.",
  },
  {
    "citations": [
      {
        "locator": "sections 2.1, 2.3, and 2.5",
        "role": "supports",
        "sourceId": "sep-feminist-political-philosophy-source",
      },
    ],
    "id": "formal-substantive-equality-boundary",
    "statementKind": "editorial-interpretation",
    "text": "Formal equality in law does not by itself establish substantive equality in material and social conditions.",
  },
  {
    "citations": [
      {
        "locator": "pp. 139–143",
        "role": "supports",
        "sourceId": "crenshaw-demarginalizing-source",
      },
    ],
    "id": "crenshaw-single-axis-limit",
    "statementKind": "observation",
    "text": "Crenshaw argues that treating race and gender as mutually exclusive categories marginalizes Black women's discrimination claims in law, feminist theory, and antiracist politics.",
  },
  {
    "citations": [
      {
        "locator": "pp. 501–509 and 522–525",
        "role": "supports",
        "sourceId": "mohanty-western-eyes-revisited-source",
      },
    ],
    "id": "mohanty-western-universal-limit",
    "statementKind": "observation",
    "text": "Mohanty argues that cross-border feminist solidarity must be built through historically specific analysis and common political struggle rather than an assumed homogeneous category of Third World women.",
  },
  {
    "citations": [
      {
        "locator": "publisher page, Description paragraphs 1–4",
        "role": "supports",
        "sourceId": "moreton-robinson-talkin-up-source",
      },
    ],
    "id": "moreton-robinson-indigenous-boundary",
    "statementKind": "observation",
    "text": "Moreton-Robinson argues that white Australian feminists' social position affects their authority to represent Indigenous women.",
  },
  {
    "citations": [
      {
        "locator": "pp. 1–2, opening and Primary Principles",
        "role": "supports",
        "sourceId": "koyama-transfeminist-manifesto-source",
      },
    ],
    "id": "koyama-transfeminist-self-description",
    "statementKind": "definition",
    "text": "Koyama describes transfeminism as a movement led principally by and for trans women whose liberation is linked with the liberation of other women and wider coalitions.",
  },
  {
    "citations": [
      {
        "locator": "p. 2, Primary Principles",
        "role": "supports",
        "sourceId": "koyama-transfeminist-manifesto-source",
      },
    ],
    "id": "koyama-body-autonomy",
    "statementKind": "attributed-value",
    "text": "Koyama's manifesto claims individual authority over gender identity, expression, and bodily decisions against political, medical, or religious coercion.",
  },
  {
    "citations": [
      {
        "locator": "p. 1, operational definitions of sex and gender",
        "role": "supports",
        "sourceId": "koyama-transfeminist-manifesto-source",
      },
    ],
    "id": "sex-gender-trans-boundary",
    "statementKind": "definition",
    "text": "Koyama distinguishes sex assignment at birth from gender identity and gender expression.",
  },
  {
    "citations": [
      {
        "locator": "opening paragraphs 1–3",
        "role": "supports",
        "sourceId": "fraser-capital-care-source",
      },
    ],
    "id": "fraser-social-reproduction-definition",
    "statementKind": "definition",
    "text": "Fraser uses social reproduction for material and affective work that sustains people, households, communities, and social bonds, much of it historically assigned to women and unpaid.",
  },
  {
    "citations": [
      {
        "locator": "opening paragraphs 4–12",
        "role": "supports",
        "sourceId": "fraser-capital-care-source",
      },
    ],
    "id": "fraser-care-capitalism-claim",
    "statementKind": "causal-hypothesis",
    "text": "Fraser argues that capitalist accumulation depends on social-reproductive activity while tending to destabilize it; this is a situated theoretical claim, not an observed effect of every market institution.",
  },
  {
    "citations": [
      {
        "locator": "PDF pp. 1–3, opening and sections 1–2",
        "role": "supports",
        "sourceId": "combahee-statement-source",
      },
      {
        "locator": "pp. 15–27 and 109–130",
        "role": "context",
        "sourceId": "taylor-combahee-reader-source",
      },
    ],
    "id": "combahee-self-description",
    "statementKind": "classification",
    "text": "The Combahee River Collective described its politics as Black feminist and socialist.",
  },
  {
    "citations": [
      {
        "locator": "PDF p. 1, opening paragraph",
        "role": "supports",
        "sourceId": "combahee-statement-source",
      },
    ],
    "id": "combahee-opposed-interlocking-oppressions",
    "statementKind": "attributed-value",
    "text": "The Combahee River Collective stated a commitment to struggle against racial, sexual, heterosexual, and class oppression.",
  },
  {
    "citations": [
      {
        "locator": "pp. 109–130, interview with Barbara Smith, Beverly Smith, and Demita Frazier",
        "role": "supports",
        "sourceId": "taylor-combahee-reader-source",
      },
      {
        "locator": "pp. 280–305",
        "role": "supports",
        "sourceId": "harris-kennedy-combahee-source",
      },
    ],
    "id": "combahee-organizing-practice",
    "statementKind": "observation",
    "text": "Between 1974 and 1980, the Boston collective used political education and coalition organizing.",
  },
  {
    "citations": [
      {
        "locator": "pp. 109–130, interview with Barbara Smith, Beverly Smith, and Demita Frazier",
        "role": "supports",
        "sourceId": "taylor-combahee-reader-source",
      },
    ],
    "id": "combahee-selected-campaigns",
    "statementKind": "observation",
    "text": "The collective organized around reproductive freedom, health care, violence against women, and the 1979 murders of Black women in Boston.",
  },
  {
    "citations": [
      {
        "locator": "pp. 1–14 and 109–130",
        "role": "supports",
        "sourceId": "taylor-combahee-reader-source",
      },
    ],
    "id": "combahee-case-boundary",
    "statementKind": "editorial-interpretation",
    "text": "The Combahee River Collective is one bounded Black feminist socialist organization; its statement and practices do not define all Black feminism or later intersectionality.",
  },
  {
    "citations": [
      {
        "locator": "Birth of SEWA, paragraphs 1–8",
        "role": "supports",
        "sourceId": "sewa-history-source",
      },
      {
        "locator": "pp. 13–17",
        "role": "context",
        "sourceId": "ilo-sewa-cooperatives-source",
      },
    ],
    "id": "sewa-union-registration",
    "statementKind": "observation",
    "text": "SEWA registered as a trade union on 12 April 1972.",
  },
  {
    "citations": [
      {
        "locator": "Birth of SEWA, paragraphs 3–8",
        "role": "supports",
        "sourceId": "sewa-history-source",
      },
    ],
    "id": "sewa-worker-definition-contest",
    "statementKind": "observation",
    "text": "SEWA's organizers challenged the claim that workers required a conventional employer before they could register a union.",
  },
  {
    "citations": [
      {
        "locator": "p. 17, Beginnings of the cooperative journey",
        "role": "supports",
        "sourceId": "ilo-sewa-cooperatives-source",
      },
    ],
    "id": "sewa-cooperative-bank",
    "statementKind": "observation",
    "text": "In 1974, 4,000 SEWA members each contributed ten rupees in share capital to establish the SEWA Cooperative Bank.",
  },
  {
    "citations": [
      {
        "locator": "p. 17, Beginnings of the cooperative journey",
        "role": "supports",
        "sourceId": "ilo-sewa-cooperatives-source",
      },
    ],
    "id": "sewa-quilt-cooperative",
    "statementKind": "observation",
    "text": "Ahmedabad quilt makers participating in SEWA formed a producer cooperative in 1977 to market their products.",
  },
  {
    "citations": [
      {
        "locator": "pp. 3, 7, and 13–17",
        "role": "supports",
        "sourceId": "ilo-sewa-cooperatives-source",
      },
      {
        "locator": "History of SEWA, paragraphs 1–6",
        "role": "context",
        "sourceId": "sewa-history-source",
      },
    ],
    "id": "sewa-case-boundary",
    "statementKind": "editorial-interpretation",
    "text": "SEWA's selected Ahmedabad union and cooperative institutions do not represent all informal workers or establish a general model of feminism.",
  },
  {
    "citations": [
      {
        "locator": "archived consolidation dated 1 October 2000, Articles 2, 4, 8, 13, and 36",
        "role": "supports",
        "sourceId": "iceland-parental-leave-law-source",
      },
      {
        "locator": "chapter 18, pp. 370–387, Abstract and Introduction",
        "role": "context",
        "sourceId": "gislason-iceland-leave-source",
      },
    ],
    "id": "iceland-leave-enacted-design",
    "statementKind": "observation",
    "text": "Iceland's 2000 law established a phased design of three non-transferable paid months for each parent plus three months parents could divide, financed and administered through a public leave fund.",
  },
  {
    "citations": [
      {
        "locator": "chapter 18, pp. 370–387, A Policy Success? § Programmatic success, paragraphs 1–5 and Figure 18.1",
        "role": "supports",
        "sourceId": "gislason-iceland-leave-source",
      },
    ],
    "id": "iceland-fathers-uptake",
    "statementKind": "observation",
    "text": "Among eligible Icelandic fathers, leave uptake rose from roughly 0.2–0.3 percent before the reform to 82.4 percent in 2001 and 89.8 percent in 2004.",
  },
  {
    "citations": [
      {
        "locator": "printed pp. 247–249, section 5.1 and Figures 2–4",
        "role": "supports",
        "sourceId": "arnalds-eydal-gislason-leave-source",
      },
    ],
    "id": "iceland-care-work-outcomes",
    "statementKind": "observation",
    "text": "Surveys of Icelandic first-time parents found that fathers performed a larger share of care after the leave reform.",
  },
  {
    "citations": [
      {
        "locator": "printed p. 250, section 5.2 and Figure 5",
        "role": "supports",
        "sourceId": "arnalds-eydal-gislason-leave-source",
      },
    ],
    "id": "iceland-labor-force-participation-gap",
    "statementKind": "observation",
    "text": "Across the surveyed cohorts, the difference between mothers' and fathers' employment rates three years after their first child's birth became smaller.",
  },
  {
    "citations": [
      {
        "locator": "printed pp. 250–251, section 5.2 and Figure 6",
        "role": "supports",
        "sourceId": "arnalds-eydal-gislason-leave-source",
      },
    ],
    "id": "iceland-working-hours-gap",
    "statementKind": "observation",
    "text": "Across the surveyed cohorts, mothers' average paid working hours increased while fathers' average paid working hours decreased.",
  },
  {
    "citations": [
      {
        "locator": "chapter 18, pp. 370–387, A Policy Success? §§ Programmatic success and Counterclaims to success",
        "role": "supports",
        "sourceId": "gislason-iceland-leave-source",
      },
    ],
    "id": "iceland-causal-transfer-limit",
    "statementKind": "observation",
    "text": "The selected Iceland studies do not isolate the leave design from every concurrent social change.",
  },
  {
    "citations": [
      {
        "locator": "chapter 18, pp. 370–387, Programmatic success, Figure 18.1, and An Enduring System § Coping with a financial crisis",
        "role": "supports",
        "sourceId": "gislason-iceland-leave-source",
      },
    ],
    "id": "iceland-payment-cuts-uptake",
    "statementKind": "observation",
    "text": "Payment cuts during Iceland's financial crisis were associated with reduced leave use by fathers, especially fathers with lower incomes.",
  },
]
`;

