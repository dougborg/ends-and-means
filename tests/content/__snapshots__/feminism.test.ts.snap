        "locator": "History of SEWA, paragraphs 1–6",
        "role": "context",
        "sourceId": "sewa-history-source",
      },
    ],
    "id": "sewa-case-boundary",
    "statementKind": "editorial-interpretation",
    "text": "SEWA's selected Ahmedabad union and cooperative institutions do not represent all informal workers or establish a general model of feminism.",
  },
  {
    "citations": [
