      "mohanty-western-universal-limit",
      "moreton-robinson-indigenous-boundary",
      "sewa-case-boundary",
    ],
    "currentLimitation": "English-language sources cannot establish which translated labels or genealogies actors in other settings claim for themselves.",
    "description": "A focused question about self-description across languages and political histories.",
    "evidenceNeeded": "Primary records in original languages, named translators and editions, oral histories where appropriate, and scholarship on local political vocabulary.",
    "id": "feminism-translation-nonwestern-naming",
    "kind": "research-obligation",
    "label": "Translation and non-Western naming",
    "obligationStatus": "open",
    "obligationType": "research-gap",
    "publicationStatus": "reviewed",
    "question": "How do movements outside English-language Western genealogies translate, reject, or rework names rendered as feminism?",
    "reviewedAt": "2026-09-06",
    "scope": "Bounded organizations and language communities; no presumption that an English family label travels unchanged.",
    "statementIds": [],
    "target": {
      "id": "feminism",
      "kind": "concept",
    },
  },
  {
    "addressedStatementIds": [
      "sex-gender-trans-boundary",
      "koyama-transfeminist-self-description",
      "koyama-body-autonomy",
      "radical-feminism-structural-boundary",
    ],
    "currentLimitation": "One transfeminist manifesto and an overview of radical-feminist disputes do not represent the strongest rival positions or their institutional effects.",
    "description": "A focused dispute over political subjects and institutional consequences.",
    "evidenceNeeded": "Located primary arguments from trans-inclusive and critical positions, testimony from affected groups, and policy-specific evidence that distinguishes claims from outcomes.",
    "id": "feminism-sex-gender-trans-boundaries",
    "kind": "research-obligation",
    "label": "Sex, gender, and trans boundaries",
    "obligationStatus": "open",
    "obligationType": "counterargument",
    "publicationStatus": "reviewed",
    "question": "How do rival feminist accounts of sex, gender, sexuality, and trans membership change proposed rules for bodily autonomy, safety, care, and association?",
    "reviewedAt": "2026-09-06",
    "scope": "Named debates and institutions rather than a binary verdict about all feminists or trans people.",
    "statementIds": [],
    "target": {
      "id": "feminism",
      "kind": "concept",
    },
    "targetSectionId": "traditions",
  },
  {
    "addressedStatementIds": [
