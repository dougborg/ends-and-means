        "sourceId": "gislason-iceland-leave-source",
      },
    ],
    "id": "iceland-leave-enacted-design",
    "statementKind": "observation",
    "text": "Iceland's 2000 law established a phased design of three non-transferable paid months for each parent plus three months parents could divide, financed and administered through a public leave fund.",
  },
  {
    "citations": [
      {
        "locator": "chapter 18, pp. 370–387, A Policy Success? § Programmatic success, paragraphs 1–5 and Figure 18.1",
        "role": "supports",
        "sourceId": "gislason-iceland-leave-source",
      },
    ],
    "id": "iceland-fathers-uptake",
    "statementKind": "observation",
