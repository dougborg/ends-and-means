exports[`Minangkabau matriliny, property, and authority > locks every Statement, Work, Source manifestation, and citation tuple > statements 1`] = `
[
  {
    "id": "matriliny-maternal-descent-definition",
    "label": "Matriliny traces descent through mothers",
    "statementKind": "definition",
    "text": "Mardoni defines Minangkabau matriliny as a kinship system in which people trace descent through their mother and earlier women in that maternal line.",
  },
  {
    "id": "matrilocality-residence-distinction",
    "label": "Matrilocality concerns residence after marriage",
    "statementKind": "observation",
    "text": "Sanday describes husbands moving into their wives’ households in the community she studied.",
  },
  {
    "id": "matriliny-does-not-fix-residence",
    "label": "Sanday distinguishes descent from residence",
    "statementKind": "observation",
    "text": "In Sanday’s account, maternal-line kin organization and husbands’ residence with their wives’ domestic groups are separately described features.",
  },
  {
    "id": "matriarchy-rule-by-women-dispute",
    "label": "Matriarchy has disputed meanings",
    "statementKind": "editorial-interpretation",
    "text": "Sanday rejects ‘rule by women’ as the only meaning of matriarchy.",
  },
  {
    "id": "minangkabau-power-varies-by-relation",
    "label": "Power varies across relationships",
    "statementKind": "editorial-interpretation",
    "text": "Blackwood argues from one late-twentieth-century village that formal titles alone did not describe the distribution of gendered power.",
  },
  {
    "id": "minangkabau-practices-historically-changing",
    "label": "Matrilineal practices change historically",
    "statementKind": "observation",
    "text": "Sebastian treats Minangkabau matrilineal practices as historically changing rather than timeless.",
  },
  {
    "id": "adat-translation-boundary",
    "label": "Adat is broader than a single rulebook",
    "statementKind": "definition",
    "text": "Adat can encompass customs, beliefs, norms, and laws; translating it only as ‘customary law’ would narrow the practices examined by the sources.",
  },
  {
    "id": "nagari-translation-boundary",
    "label": "Nagari joins community and government",
    "statementKind": "definition",
    "text": "Nagari is retained for a West Sumatran community and territorial jurisdiction whose customary institutions interact with Indonesian village administration; it is not treated as interchangeable with village in every period.",
  },
  {
    "id": "minangkabau-legal-orders-interact",
    "label": "Adat, Islamic, and state institutions interact",
    "statementKind": "observation",
    "text": "Sebastian describes Minangkabau adat, Islamic authority, and state law as interacting rather than isolated domains.",
  },
  {
    "id": "minangkabau-ancestral-acquired-property-distinction",
    "label": "Ancestral and acquired property are distinct categories",
    "statementKind": "observation",
    "text": "In 1990s Padang, Colombijn distinguishes high ancestral property from harta pencaharian acquired through a person’s own efforts.",
  },
  {
    "id": "koto-tinggi-minangkabau-adat-context",
    "label": "Koto Tinggi’s institutions were presented in an adat context",
    "statementKind": "observation",
    "text": "Nurdin presents Koto Tinggi as a Minangkabau nagari in which revived adat institutions interacted with post-decentralization public administration.",
  },
  {
    "id": "koto-tinggi-fieldwork-scope",
    "label": "The Koto Tinggi study used four field methods",
    "statementKind": "observation",
    "text": "Nurdin reports using observation, interviews, a focus group, and document study in Koto Tinggi during October 2016.",
  },
  {
    "id": "koto-tinggi-three-institutions",
    "label": "Koto Tinggi had an elected executive",
    "statementKind": "observation",
    "text": "Under Agam Regulation 12 of 2007, Koto Tinggi’s nagari structure included an elected wali nagari and executive staff.",
  },
  {
    "id": "koto-tinggi-formal-participation-rules",
    "label": "Formal planning rules included women’s-group delegates",
    "statementKind": "observation",
    "text": "Nurdin reports that the Nagari Council convened development meetings whose invited delegates included representatives of women’s groups.",
  },
  {
    "id": "koto-tinggi-formal-decision-rule",
    "label": "Formal meetings required a two-thirds quorum",
    "statementKind": "observation",
    "text": "The formal meeting procedure required a two-thirds quorum.",
  },
  {
    "id": "koto-tinggi-customary-council-contestation",
    "label": "Customary leaders contested the dual-council design",
    "statementKind": "observation",
    "text": "The Koto Tinggi customary-council head and another adat leader told Nurdin that the representative council displaced the customary council from legislative work.",
  },
  {
    "id": "koto-tinggi-budget-rules-in-use",
    "label": "The 2016 draft budget arrived too late for review",
    "statementKind": "observation",
    "text": "In 2016 the wali nagari delivered a draft budget too late for council review.",
  },
  {
    "id": "koto-tinggi-budget-consensus",
    "label": "The reconvened budget meeting reached consensus",
    "statementKind": "observation",
    "text": "The reconvened 2016 meeting reached consensus on allocations for infrastructure, housing repairs, and scholarships.",
  },
  {
    "id": "koto-tinggi-administrative-capacity-limit",
    "label": "Koto Tinggi had incomplete planning documents",
    "statementKind": "observation",
    "text": "Nurdin reports incomplete planning documents in Koto Tinggi.",
  },
  {
    "id": "koto-tinggi-regulatory-preparation-limit",
    "label": "Council members reported inadequate regulatory preparation",
    "statementKind": "observation",
    "text": "Council members told Nurdin that nagari personnel had not been adequately prepared for changing regulations.",
  },
  {
    "id": "bonjol-study-method-and-voice",
    "label": "The Bonjol study used four months of participant observation",
    "statementKind": "observation",
    "text": "The Bonjol study conducted participant observation from January through April 2016.",
  },
  {
    "id": "bonjol-new-nagari-forest-transition",
    "label": "Bonjol became a separate nagari around 2000",
    "statementKind": "observation",
    "text": "The Bonjol study reports that decentralization ended desa administration around 2000 and Bonjol became a separate nagari.",
  },
  {
    "id": "bonjol-concession-end-transition",
    "label": "A concession ending changed forest access",
    "statementKind": "observation",
    "text": "When a forest concession ended in 2002, Melayu-clan leaders and state and company actors negotiated access to land claimed both as state forest and ulayat.",
  },
  {
    "id": "bonjol-ulayat-formal-distinction",
    "label": "Melayu-clan ulayat was collectively held",
    "statementKind": "observation",
    "text": "The study describes Melayu-clan ulayat as collectively held land to which clan members could seek access.",
  },
  {
    "id": "bonjol-ulayat-delegated-management",
    "label": "Named officeholders managed ulayat for the clan",
    "statementKind": "observation",
    "text": "A Datuak, or titled customary leader, and mamak kepala waris, maternal-kin property managers, managed the Melayu clan’s ulayat rather than owning it personally.",
  },
  {
    "id": "bonjol-harta-pusaka-transition",
    "label": "Cleared land entered a different inheritance category",
    "statementKind": "observation",
    "text": "The authors report that forest land opened for cultivation became harta pusaka, rendered harato pusako in their article.",
  },
  {
    "id": "bonjol-bundo-kanduang-role",
    "label": "Bundo Kanduang was an advisory maternal role",
    "statementKind": "observation",
    "text": "The Bonjol authors describe Bundo Kanduang as a respected senior maternal figure who could advise customary leaders.",
  },
  {
    "id": "bonjol-ulayat-sales-rules-in-use",
    "label": "Officeholders facilitated outsider land transactions",
    "statementKind": "observation",
    "text": "Key informants reported that male customary officeholders facilitated transactions giving officials and other outsiders access to large areas of Melayu-clan ulayat.",
  },
  {
    "id": "bonjol-neshp-formal-promise",
    "label": "The oil-palm agreement promised household plots",
    "statementKind": "observation",
    "text": "An agreement negotiated by male clan representatives called for 1,000 hectares of oil-palm smallholdings to be divided into two-hectare plots for 500 Bonjol households as compensation for transferred land.",
  },
  {
    "id": "bonjol-neshp-distribution-practice",
    "label": "Male signatories controlled the recipient list",
    "statementKind": "observation",
    "text": "The study reports that male signatories controlled the recipient list for the promised smallholdings.",
  },
  {
    "id": "bonjol-neshp-exclusion-outcome",
    "label": "The recipient list favored signatories’ associates",
    "statementKind": "observation",
    "text": "The authors report that the recipient list favored signatories’ relatives and associates.",
  },
  {
    "id": "bonjol-women-testimony-limit",
    "label": "Many women declined to discuss the land dispute",
    "statementKind": "observation",
    "text": "Researchers report that many women declined to discuss the contested land practices.",
  },
  {
    "id": "bonjol-five-women-testimony",
    "label": "Five women described anger about the dispute",
    "statementKind": "observation",
    "text": "A group of five Melayu women described anger about the land dispute.",
  },
  {
    "id": "bonjol-authors-causal-interpretation",
    "label": "The authors identify limited education as one possible cause",
    "statementKind": "causal-hypothesis",
    "text": "Mutolib and colleagues attribute women’s weak influence partly to limited education.",
  },
  {
    "id": "bonjol-no-minangkabau-generalization",
    "label": "The Bonjol findings are not society-wide",
    "statementKind": "observation",
    "text": "The authors explicitly caution that findings about Melayu-clan forest management in Bonjol should not be generalized to ulayat practice or women’s position across Minangkabau communities.",
  },
  {
    "id": "nagari-law-changed-after-cases",
    "label": "The provincial nagari framework changed after both studies",
    "statementKind": "observation",
    "text": "West Sumatra Regulation 7 of 2018 established a later provincial framework for nagari as customary-law community government.",
  },
  {
    "id": "matriliny-does-not-fix-property-control",
    "label": "Property control varied within Blackwood’s village study",
    "statementKind": "observation",
    "text": "Blackwood reports senior women controlling land in the Minangkabau village she studied.",
  },
  {
    "id": "matriliny-does-not-fix-office",
    "label": "Kin authority and land control differed in Blackwood’s study",
    "statementKind": "observation",
    "text": "Blackwood reports men claiming formal kin authority in the village where she observed senior women controlling land.",
  },
  {
    "id": "matriliny-does-not-fix-equality",
    "label": "Bonjol’s authors reject an equality inference",
    "statementKind": "observation",
    "text": "The Bonjol authors caution that matrilineal inheritance in their case did not make women equal participants in decisions over communal forest resources.",
  },
  {
    "id": "matriarchy-sanday-maternal-centered-interpretation",
    "label": "Sanday offers a maternal-centered interpretation",
    "statementKind": "editorial-interpretation",
    "text": "Sanday interprets Minangkabau matriarchaat through maternal meanings and women’s social centrality.",
  },
  {
    "id": "koto-tinggi-descent-unobserved",
    "label": "The Koto Tinggi study does not document descent",
    "statementKind": "observation",
    "text": "Nurdin’s Koto Tinggi study does not separately document descent practice.",
  },
  {
    "id": "koto-tinggi-residence-unobserved",
    "label": "The Koto Tinggi study does not document postmarital residence",
    "statementKind": "observation",
    "text": "Nurdin’s Koto Tinggi study does not separately document postmarital residence.",
  },
  {
    "id": "koto-tinggi-participant-count-unreported",
    "label": "The Koto Tinggi study omits participant counts",
    "statementKind": "observation",
    "text": "The Koto Tinggi article does not report participant counts.",
  },
  {
    "id": "koto-tinggi-womens-voice-unidentified",
    "label": "The Koto Tinggi study does not identify women’s testimony",
    "statementKind": "observation",
    "text": "The Koto Tinggi article does not identify whose testimony represented women’s experience.",
  },
  {
    "id": "koto-tinggi-formal-speaking-rule",
    "label": "The procedure allowed participants to speak",
    "statementKind": "observation",
    "text": "The formal meeting procedure allowed participants to express their views before a decision.",
  },
  {
    "id": "koto-tinggi-formal-consensus-rule",
    "label": "The procedure preferred consensus",
    "statementKind": "observation",
    "text": "The formal meeting procedure preferred consensus.",
  },
  {
    "id": "koto-tinggi-formal-vote-fallback",
    "label": "The procedure allowed a vote if consensus failed",
    "statementKind": "observation",
    "text": "The formal meeting procedure permitted majority voting if consensus failed.",
  },
  {
    "id": "bonjol-harta-pusaka-female-line",
    "label": "The Bonjol study describes female-line transmission",
    "statementKind": "observation",
    "text": "The Bonjol authors describe harta pusaka as ancestral property transmitted through the female line.",
  },
  {
    "id": "bonjol-inheritance-did-not-confer-office-authority",
    "label": "Inheritance did not confer forest-negotiation authority",
    "statementKind": "observation",
    "text": "In the Bonjol study, women’s inherited claims did not confer the authority held by male officeholders to negotiate forest access.",
  },
  {
    "id": "bonjol-bundo-kanduang-not-universal-authority",
    "label": "Bundo Kanduang did not confer authority on every woman",
    "statementKind": "editorial-interpretation",
    "text": "The Bundo Kanduang role described in the Bonjol study does not establish that every woman controlled ulayat decisions.",
  },
  {
    "id": "bonjol-authors-early-marriage-hypothesis",
    "label": "The authors identify early marriage as one possible cause",
    "statementKind": "causal-hypothesis",
    "text": "Mutolib and colleagues attribute women’s weak influence partly to early marriage.",
  },
  {
    "id": "bonjol-authors-gender-norms-hypothesis",
    "label": "The authors identify gender norms as one possible cause",
    "statementKind": "causal-hypothesis",
    "text": "Mutolib and colleagues attribute women’s weak influence partly to gender norms.",
  },
  {
    "id": "bonjol-authors-forum-hypothesis",
    "label": "The authors identify lack of a forum as one possible cause",
    "statementKind": "causal-hypothesis",
    "text": "Mutolib and colleagues attribute women’s weak influence partly to the lack of a forum for women.",
  },
  {
    "id": "bonjol-authors-representation-dependence-hypothesis",
    "label": "The authors identify dependence on male representatives",
    "statementKind": "causal-hypothesis",
    "text": "Mutolib and colleagues attribute women’s weak influence partly to dependence on male customary representatives.",
  },
  {
    "id": "bonjol-causal-identification-limit",
    "label": "The Bonjol study cannot isolate the proposed causes",
    "statementKind": "editorial-interpretation",
    "text": "The Bonjol study’s small cross-sectional design cannot isolate the effects of the causes proposed by its authors.",
  },
  {
    "id": "koto-tinggi-representative-council",
    "label": "Koto Tinggi had a representative Nagari Council",
    "statementKind": "observation",
    "text": "Under Agam Regulation 12 of 2007, Koto Tinggi’s nagari structure included a representative Nagari Council.",
  },
  {
