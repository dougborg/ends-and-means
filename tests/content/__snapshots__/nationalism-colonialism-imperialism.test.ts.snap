  "statements": [
    {
      "description": "Nationalism can name attachments or action",
      "id": "nationalism-attitude-program-boundary",
      "kind": "statement",
      "label": "Nationalism can name attachments or action",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "definition",
      "text": "Nationalism can name concern for national identity or action seeking national self-determination; neither usage by itself identifies a state, party, movement, or institutional practice.",
    },
    {
      "description": "Nations and states are not synonyms",
      "id": "nation-state-boundary",
      "kind": "statement",
      "label": "Nations and states are not synonyms",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "definition",
      "text": "A nation is a claimed community of belonging while a state is a political and legal organization; a nation may lack a state and one state may contain several national claims.",
    },
    {
      "description": "Self-determination need not mean full statehood",
      "id": "self-determination-statehood-boundary",
      "kind": "statement",
      "label": "Self-determination need not mean full statehood",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "definition",
      "text": "National self-determination can be claimed through statehood, autonomy, federation, or other authority arrangements, and formal sovereignty does not establish effective control.",
    },
    {
      "description": "Anderson defines nations through social imagination",
      "id": "anderson-imagined-community",
      "kind": "statement",
      "label": "Anderson defines nations through social imagination",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "definition",
      "text": "Anderson defines a nation as an imagined political community understood as limited and sovereign, without treating imagination as falsity.",
    },
    {
      "description": "Asserted fraternity can coexist with inequality",
      "id": "anderson-horizontal-inequality",
      "kind": "statement",
      "label": "Asserted fraternity can coexist with inequality",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "Anderson argues that nations are imagined as horizontal comradeship even where inequality and exploitation persist.",
    },
    {
      "description": "Chatterjee disputes universal nationalist scripts",
      "id": "chatterjee-derivative-dispute",
      "kind": "statement",
      "label": "Chatterjee disputes universal nationalist scripts",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "Chatterjee argues that anticolonial nationalism challenged European domination while remaining constrained by post-Enlightenment categories it sought to reject.",
    },
    {
      "description": "State nationalism can appropriate national life",
      "id": "chatterjee-state-unity-limit",
      "kind": "statement",
      "label": "State nationalism can appropriate national life",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "Chatterjee argues that ruling classes can convert anticolonial nationalism into a state ideology whose asserted unity does not subsume the whole life of a nation.",
    },
    {
      "description": "Tagore distinguishes political nation from society",
      "id": "tagore-nation-society-rival",
      "kind": "statement",
      "label": "Tagore distinguishes political nation from society",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "Tagore's 1917 lectures criticize the organized political and commercial power he calls the Nation and distinguish it from society and living social relations.",
    },
    {
      "description": "A nationalist label does not prove practice",
      "id": "nationalism-self-description-limit",
      "kind": "statement",
      "label": "A nationalist label does not prove practice",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "Self-description as national or nationalist establishes an attributed identity or program, not who was included, which institutions operated, or how authority was exercised.",
    },
    {
      "description": "National unity does not establish inclusion",
      "id": "national-unity-exclusion-boundary",
      "kind": "statement",
      "label": "National unity does not establish inclusion",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "An assertion of national unity cannot establish equal membership across race, caste, class, gender, religion, language, region, citizenship, or Indigenous status.",
    },
    {
      "description": "Colonialism involves domination",
      "id": "colonialism-domination-definition",
      "kind": "statement",
      "label": "Colonialism involves domination",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "definition",
      "text": "Kohn and Reddy define colonialism as a practice in which one people subjugates another, while warning that its boundary with imperialism is disputed.",
    },
    {
      "description": "Colonization and colonialism are not interchangeable",
      "id": "colonization-colonialism-boundary",
      "kind": "statement",
      "label": "Colonization and colonialism are not interchangeable",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "definition",
      "text": "Population movement or settlement can occur without the full relation called colonialism, while colonial domination can operate through administration, extraction, labor coercion, or local intermediaries without mass settlement.",
    },
    {
      "description": "Colonialism and imperialism have disputed institutional boundaries",
      "id": "colonial-arrangements-plural",
      "kind": "statement",
      "label": "Colonialism and imperialism have disputed institutional boundaries",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "definition",
      "text": "Kohn and Reddy distinguish colonization through settlement and political control from imperial command that can also operate indirectly, while noting that the concepts' boundary is disputed.",
    },
    {
      "description": "Colonial mobilization could reconfigure political concepts",
      "id": "colonial-formal-practice-boundary",
      "kind": "statement",
      "label": "Colonial mobilization could reconfigure political concepts",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "Cooper's publisher summary attributes to the book an account of citizenship and equality being reconfigured through political mobilizations in colonial contexts.",
    },
    {
      "description": "Silva centers Hawaiian-language resistance records",
      "id": "colonial-archive-mediation",
      "kind": "statement",
      "label": "Silva centers Hawaiian-language resistance records",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "Duke University Press describes Silva's study as recovering Kanaka Maoli resistance through Hawaiian-language newspapers and the petitions against annexation.",
    },
    {
      "description": "Césaire rejects a civilizing equation",
      "id": "cesaire-colonization-civilization-rival",
      "kind": "statement",
      "label": "Césaire rejects a civilizing equation",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "Césaire rejects the claim that colonization equals civilization and instead presents colonial contact as domination organized around force and extraction.",
    },
    {
      "description": "Cooper favors bounded colonial processes",
      "id": "cooper-category-boundary",
      "kind": "statement",
      "label": "Cooper favors bounded colonial processes",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "Cooper warns that treating colonialism as an all-purpose explanatory category can obscure the specific institutions, struggles, and political alternatives operating in a place and period.",
    },
    {
      "description": "Racialized sovereign inequality prompted institutional alternatives",
      "id": "decolonization-independence-boundary",
      "kind": "statement",
      "label": "Racialized sovereign inequality prompted institutional alternatives",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "Getachew argues that Black Atlantic thinkers responded to racialized sovereign inequality by proposing alternatives including self-determination through the United Nations and regional federations.",
    },
    {
      "description": "Kaulia spoke for lāhui opposition to annexation",
      "id": "kaulia-lahui-annexation-refusal",
      "kind": "statement",
      "label": "Kaulia spoke for lāhui opposition to annexation",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "attributed-value",
      "text": "Silva reports that in 1897 Hui Aloha ʻĀina president James Keauiluna Kaulia called the opposing public ka lāhui and said it would never consent to annexation while the last aloha ʻāina lived.",
    },
    {
      "description": "Silva asserts continuing Kanaka Maoli sovereignty",
      "id": "silva-continuing-sovereignty-claim",
      "kind": "statement",
      "label": "Silva asserts continuing Kanaka Maoli sovereignty",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "attributed-value",
      "text": "Writing in 1998, Silva states that Kānaka Maoli had never relinquished national sovereignty and continued seeking recognition and defending rights to land, waters, language, and cultural traditions.",
    },
    {
      "description": "Colonial rule is not a modernization stage",
      "id": "colonial-modernization-boundary",
      "kind": "statement",
      "label": "Colonial rule is not a modernization stage",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "Colonial rule cannot be inferred to be a universal stage between an earlier society and a modern nation-state, and infrastructure or administrative change does not prove a civilizing purpose or effect.",
    },
    {
      "description": "Imperialism concerns extended power",
      "id": "imperialism-power-extension-definition",
      "kind": "statement",
      "label": "Imperialism concerns extended power",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "definition",
      "text": "Imperialism can name projects, practices, relations, or theories of extending political or economic power beyond an existing center through formal or indirect mechanisms.",
    },
    {
      "description": "Empire and imperialism are not synonyms",
      "id": "empire-imperialism-boundary",
      "kind": "statement",
      "label": "Empire and imperialism are not synonyms",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "definition",
      "text": "An empire is a historically bounded political formation; imperialism is an attributed project, practice, relation, or explanatory theory and cannot be inferred from a polity's name alone.",
    },
    {
      "description": "Nkrumah identifies several neo-colonial mechanisms",
      "id": "imperial-mechanisms-plural",
      "kind": "statement",
      "label": "Nkrumah identifies several neo-colonial mechanisms",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "causal-hypothesis",
      "text": "Nkrumah identifies retained military bases, land and mineral concessions, customs and administrative privileges, currency control, tax exemptions, and tied aid as mechanisms that can constrain sovereignty.",
    },
    {
      "description": "Formal sovereignty does not settle external control",
      "id": "formal-informal-empire-boundary",
      "kind": "statement",
      "label": "Formal sovereignty does not settle external control",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "Formal sovereignty distinguishes legal status but neither proves effective self-determination nor by itself demonstrates informal empire.",
    },
    {
      "description": "Nkrumah defines neo-colonial constraint",
      "id": "nkrumah-neocolonial-definition",
      "kind": "statement",
      "label": "Nkrumah defines neo-colonial constraint",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "causal-hypothesis",
      "text": "Nkrumah argues that a formally independent state's economic system and policy can be directed from outside; this is an attributed causal theory requiring evidence of the mechanism in each case.",
    },
    {
      "description": "Imperialism may exceed settlement",
      "id": "sep-indirect-imperial-boundary",
      "kind": "statement",
      "label": "Imperialism may exceed settlement",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "definition",
      "text": "Kohn and Reddy distinguish imperialism by its focus on command exercised through settlement, sovereignty, or indirect control, rather than making population transfer necessary.",
    },
    {
      "description": "Cultural projects require a power mechanism",
      "id": "imperial-cultural-project-boundary",
      "kind": "statement",
      "label": "Cultural projects require a power mechanism",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "A cultural influence or civilizing claim is not by itself proof of imperialism; analysis must identify actors, authority, material leverage, scope, and effects.",
    },
    {
      "description": "Capitalist theories do not exhaust imperialism",
      "id": "capitalist-imperialism-rival-boundary",
      "kind": "statement",
      "label": "Capitalist theories do not exhaust imperialism",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "Theories tying imperial expansion to capitalist accumulation compete with geopolitical, strategic, cultural, and state-centered explanations and must remain attributed rather than inherited from capitalism.",
    },
    {
      "description": "Nkrumah's mechanisms are an attributed diagnosis",
      "id": "imperial-allegation-proof-boundary",
      "kind": "statement",
      "label": "Nkrumah's mechanisms are an attributed diagnosis",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "Nkrumah presents specific retained privileges as mechanisms of neo-colonialism; applying that diagnosis to another relationship requires evidence that the claimed privilege operated there.",
    },
    {
      "description": "Cooper rejects an inevitable empire-to-nation sequence",
      "id": "imperial-country-essence-boundary",
      "kind": "statement",
      "label": "Cooper rejects an inevitable empire-to-nation sequence",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "The publisher summary of Cooper's book rejects portraying the past two centuries as an inevitable movement from empire to nation-state and instead notes wider imperial and diasporic political imaginations.",
    },
    {
      "description": "Hawaiian petitions documented mass opposition",
      "id": "hawaii-petition-scale",
      "kind": "statement",
      "label": "Hawaiian petitions documented mass opposition",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "observation",
      "text": "Hui Aloha ʻĀina's bilingual 1897 petition against annexation carried 21,269 Native Hawaiian signatures collected across five principal islands.",
    },
    {
      "description": "The petition preserves Hawaiian-language political action",
      "id": "hawaii-petition-language-provenance",
      "kind": "statement",
      "label": "The petition preserves Hawaiian-language political action",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "observation",
      "text": "The petition presented Hawaiian and English texts; the National Archives repository supplies access but does not replace the named Hawaiian organization and signatories as the political actors.",
    },
    {
      "description": "Annexation followed treaty defeat",
      "id": "hawaii-annexation-sequence",
      "kind": "statement",
      "label": "Annexation followed treaty defeat",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "observation",
      "text": "The 1897 annexation treaty failed to secure Senate support after organized opposition, while Congress enacted annexation through the Newlands joint resolution in July 1898.",
    },
    {
      "description": "Three Hawaiian organizations formed an anti-annexation coalition",
      "id": "hawaii-case-boundary",
      "kind": "statement",
      "label": "Three Hawaiian organizations formed an anti-annexation coalition",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "observation",
      "text": "Silva reports that Hui Aloha ʻĀina for Women, Hui Aloha ʻĀina for Men, and Hui Kālaiʻāina formed a coalition opposing the 1897 treaty and together represented a majority of Kānaka Maoli.",
    },
    {
      "description": "Twenty-nine governments met at Bandung",
      "id": "bandung-participation",
      "kind": "statement",
      "label": "Twenty-nine governments met at Bandung",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "observation",
      "text": "Delegations from twenty-nine Asian and African governments met at Bandung from 18 through 24 April 1955.",
    },
    {
      "description": "Bandung condemned colonialism while affirming sovereignty",
      "id": "bandung-anticolonial-principles",
      "kind": "statement",
      "label": "Bandung condemned colonialism while affirming sovereignty",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "attributed-value",
      "text": "The Final Communiqué declared colonialism in all its manifestations an evil and paired self-determination with sovereignty, territorial integrity, non-intervention, and equality among nations.",
    },
    {
      "description": "Anticolonial nationalists pursued worldmaking projects",
      "id": "bandung-worldmaking-boundary",
      "kind": "statement",
      "label": "Anticolonial nationalists pursued worldmaking projects",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "Getachew argues that selected Black Atlantic anticolonial nationalists sought to remake international order rather than act solely as nation-builders.",
    },
    {
      "description": "The Ghana Independence Act changed formal status",
      "id": "ghana-legal-independence",
      "kind": "statement",
      "label": "The Ghana Independence Act changed formal status",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "observation",
      "text": "The Ghana Independence Act provided that from 6 March 1957 the Gold Coast would form part of Her Majesty's dominions under the name Ghana and that UK governmental responsibility would cease.",
    },
    {
      "description": "Getachew places Nkrumah within anticolonial worldmaking",
      "id": "ghana-worldmaking-project",
      "kind": "statement",
      "label": "Getachew places Nkrumah within anticolonial worldmaking",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "Getachew includes Nkrumah among Black Atlantic anticolonial thinkers and identifies regional African federations among their projects for transforming international order.",
    },
    {
      "description": "Ghanaian independence cannot prove economic autonomy",
      "id": "ghana-neocolonial-limit",
      "kind": "statement",
      "label": "Ghanaian independence cannot prove economic autonomy",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "The 1957 legal transition establishes a change in constitutional responsibility, not whether later property, finance, trade, or military relationships satisfied Nkrumah's neo-colonial diagnosis.",
    },
    {
      "description": "Resolution 1514 linked self-determination and independence",
      "id": "un-1514-self-determination",
      "kind": "statement",
      "label": "Resolution 1514 linked self-determination and independence",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "attributed-value",
      "text": "UN General Assembly resolution 1514 declared that all peoples have a right to self-determination and called for transfer of powers to peoples of trust and non-self-governing territories.",
    },
    {
      "description": "Anticolonial projects exceeded nation-state succession",
      "id": "decolonization-sequence-limit",
      "kind": "statement",
      "label": "Anticolonial projects exceeded nation-state succession",
      "publicationStatus": "reviewed",
      "reviewedAt": "2026-09-06",
      "statementKind": "editorial-interpretation",
      "text": "Getachew argues that accounts of decolonization as an inevitable transition from empires to nation-states obscure Black Atlantic projects for regional federation and transformed international institutions.",
    },
